<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><button class="link-button" bindtap="subjects" disabled="{{busy}}">切换就诊人</button></view><view class="title">{{source?'预约改期':'预约就诊'}}</view><view class="steps">{{source?'选择新的就诊时间':'第 2 步 · 选时段'}}</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text></view>  <view wx:if="{{busy && !ready}}" class="notice">正在读取预约安排…</view>
  <button wx:if="{{!busy && !ready && error}}" class="secondary" bindtap="load">重新读取</button>
  <block wx:if="{{ready}}">
  <view wx:if="{{source}}" class="card"><view class="pill">原预约 #{{source.id}}</view><view>{{source.clinic}} · {{source.dentist}}</view><view>{{source.startLabel}} 至 {{source.endLabel}}</view><view class="muted">成功确认前保留原约；仅可在本店调整同一服务。</view></view>
  <label class="label">诊所</label><picker class="picker" range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="pickClinic" disabled="{{!!source || busy}}">{{clinics[clinicIndex].name || '暂无可选诊所'}}</picker>
  <label class="label">预约服务</label><picker class="picker" range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="pickService" disabled="{{!!source || busy}}">{{services[serviceIndex].name || '暂无已发布服务'}} · {{services[serviceIndex].duration || '—'}}分钟</picker>
  <view wx:if="{{!source && selectedService}}" class="card"><view>{{selectedService.summary}}</view><view class="fee">{{selectedService.fee_label}}</view><view class="prose">{{selectedService.fee_note}}</view><navigator class="link" url="/pages/service/index?id={{selectedService.id}}">核对服务内容与到诊准备</navigator></view>
  <view class="row tabs"><button class="{{mode==='date'?'selected':''}}" data-mode="date" bindtap="setMode">按日期</button><button class="{{mode==='dentist'?'selected':''}}" data-mode="dentist" bindtap="setMode">按医师</button></view>
  <label class="label">就诊日期 北京时间</label><picker class="picker" mode="date" value="{{day}}" start="{{firstDay}}" end="{{lastDay}}" bindchange="pickDay" disabled="{{busy}}">{{day || '请选择日期'}}</picker>
  <view wx:if="{{mode==='dentist'}}" class="muted small">按医师查询省略日期，读取未来十四天的可约时段；已选门店、服务、医师和日期保持不变。</view>
  <label class="label">医师偏好</label><picker class="picker" range="{{doctors}}" range-key="name" value="{{doctorIndex}}" bindchange="pickDoctor" disabled="{{busy}}">{{doctors[doctorIndex].name}}</picker>
  <view wx:if="{{source}}"><label class="label" for="reason">改期原因</label><textarea id="reason" value="{{reason}}" maxlength="500" bindinput="reason" placeholder="请说明安排方面的原因" aria-label="改期原因" /></view>
  <view wx:if="{{!source}}"><label class="label" for="patientRequest">本次希望解决什么问题？（选填）</label><textarea id="patientRequest" value="{{patientRequest}}" maxlength="500" bindinput="patientRequest" placeholder="可简要说明就诊需求，请勿填写证件号或无关隐私" aria-label="本次就诊需求，选填" /><view class="muted">将保存到本次预约，供接诊人员了解；具体诊疗由面诊确认。</view></view>
<button wx:if="{{selectedService}}" class="primary" loading="{{busy}}" disabled="{{busy || !day}}" bindtap="search">查询可用时段</button>
  <view class="muted">椅位和必要设备由系统统一核对。服务时长用于排程，实际治疗与费用由接诊后确认。</view>
  <view wx:if="{{note && (!searched || rows.length)}}" class="notice">{{note}}<button wx:if="{{!source && !day}}" class="secondary" bindtap="waitlist">登记候补</button></view>
  <block wx:if="{{mode==='date'}}"><view wx:for="{{rows}}" wx:key="id" class="card"><view class="time">{{item.startLabel}}</view><view>至 {{item.endLabel}} · {{item.dentist}}</view><button class="secondary" disabled="{{busy}}" data-index="{{index}}" bindtap="choose">选择并核对</button></view></block>
  <block wx:if="{{mode==='dentist'}}"><view wx:for="{{groups}}" wx:key="id" wx:for-index="gi" class="card"><view class="section-title">{{item.name}}</view><view class="muted">本次查询最早可约 {{item.earliestLabel}} · 共 {{item.count}} 个时段</view><view wx:for="{{item.expanded?item.rows:item.preview}}" wx:for-item="slot" wx:key="id" class="invoice-line"><view class="time">{{slot.startLabel}}</view><view>至 {{slot.endLabel}}</view><button class="secondary" disabled="{{busy}}" data-index="{{slot.index}}" bindtap="choose">选择并核对</button></view><button wx:if="{{!item.expanded && item.count>3}}" class="compact secondary" data-index="{{gi}}" bindtap="expandGroup">查看该医师全部 {{item.count}} 个时段</button></view></block>
  <view wx:if="{{searched && !rows.length}}" class="card empty"><view class="section-title">{{availabilityTitle}}</view><view>{{emptyReason || note || (source ? '可选择其他日期，原预约继续保留。' : '可换日期或医师，也可登记候补。')}}</view><view wx:if="{{note}}" class="muted">{{note}}</view><view class="action-row"><button class="secondary" bindtap="nextDay">换日期</button><button class="secondary" bindtap="nextDoctor">换医师</button><button wx:if="{{!source}}" class="secondary" bindtap="waitlist">登记候补</button></view></view>
  <view wx:if="{{searchFailed}}" class="card empty"><view class="section-title">查询未完成</view><view>本次读取没有返回号源，请确认网络后重新查询；原有安排不受影响。</view><button class="secondary" bindtap="search">重新查询</button></view>
  </block>
  <navigator open-type="switchTab" wx:if="{{!source}}" class="link" url="/pages/services/index">返回查看服务</navigator>
  <navigator class="link" url="/pages/help/index">联系前台协调候补或其他安排</navigator>
</view>
