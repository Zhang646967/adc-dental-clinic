<view class="page"><view class="page-heading"><view class="brand">诊疗预约</view><view class="title">这次想解决什么问题？</view><view class="muted">先了解服务，再核对医师、日期与资源。</view></view>
  <view class="card"><view wx:if="{{city}}" class="fact-row"><text>当前城市：{{city}}</text><button class="link-button" bindtap="allCities" disabled="{{busy}}">查看全部城市</button></view><view class="label">服务方向</view><picker disabled="{{busy}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="pickCategory"><view class="picker">{{categories[categoryIndex].name}} ▾</view></picker><view class="label">就诊门店</view><picker disabled="{{busy}}" range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="pickClinic"><view class="picker">{{clinics[clinicIndex].name}} ▾</view></picker><input value="{{keyword}}" bindinput="keyword" bindconfirm="search" placeholder="搜索服务或就诊需求" maxlength="80" aria-label="服务搜索"/><button class="secondary" bindtap="search" disabled="{{busy}}">查找服务</button></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button bindtap="search">重新连接</button></view><view wx:if="{{busy}}" class="notice">正在核对门店服务…</view><view wx:if="{{!busy&&!error}}" class="muted line">{{count}} 项服务 · {{page}} / {{pages}} 页</view>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view class="status">{{item.category_label}}</view><view class="section-title">{{item.name}}</view><view class="muted">{{item.clinic_name}}</view><view class="line">{{item.summary}}</view><view class="fact-row"><text>预计 {{item.duration}} 分钟</text><text>{{item.fee_label}}</text></view><button class="primary" bindtap="open" data-id="{{item.id}}">了解服务并选择时间</button></view>
  <view wx:if="{{!busy&&!error&&message}}" class="notice">{{message}}</view><view wx:if="{{!busy&&!error&&!rows.length&&alternatives.length}}" class="card"><view class="section-title">这些门店可以继续办理</view><button wx:for="{{alternatives}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="alternative">{{item.name}} · {{item.district}} →</button></view>
  <view class="action-row"><button wx:if="{{page>1}}" bindtap="previous" disabled="{{busy}}">上一页</button><button wx:if="{{page<pages}}" bindtap="next" disabled="{{busy}}">下一页</button></view>
</view>
