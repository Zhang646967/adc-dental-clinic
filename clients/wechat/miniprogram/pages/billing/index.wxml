<view class="page patient-flow">
  <view class="page-heading"><view class="title">费用查询</view><view class="muted">本人已发布结算单的当前版本、应付或应退金额。</view></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text><button class="secondary" bindtap="retry">重新读取</button></view>
  <view wx:if="{{busy}}" class="notice">正在读取本人费用…</view>
  <block wx:if="{{!busy&&!error}}">
    <view wx:if="{{!rows.length}}" class="card empty"><view class="section-title">暂无已发布结算单</view><view class="muted">就诊完成并发布结算后，可在这里查看金额与明细。</view></view>
    <view wx:for="{{rows}}" wx:key="id" class="card" aria-label="{{item.ariaLabel}}">
      <view class="record-head">
        <view class="pill status-upcoming">{{item.versionLabel}}</view>
        <view class="pill {{item.status.tone}}">{{item.status.label}}</view>
      </view>
      <view class="section-title">{{item.clinic}}</view>
      <view class="muted">就诊 {{item.scheduledLabel}}（北京时间）</view>
      <view class="muted billing-no">{{item.invoiceNo}}</view>
      <view wx:if="{{item.status.amount}}" class="invoice-total"><text>{{item.status.label}}</text><text>¥ {{item.status.amount}}</text></view>
      <view wx:if="{{item.status.note}}" class="notice">{{item.status.note}}</view>
      <button class="primary" data-index="{{index}}" bindtap="open" aria-label="{{item.ariaLabel}}，{{item.openLabel}}">{{item.openLabel}}</button>
    </view>
    <view wx:if="{{pages>1}}" class="row"><button class="secondary" disabled="{{!hasPrevious || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button class="secondary" disabled="{{!hasNext || busy}}" data-step="1" bindtap="turn">下一页</button></view>
    <view class="muted small">共 {{count}} 张结算单。</view>
  </block>
  <view class="card patient-section task-links"><view class="section-title">其他资金入口</view><navigator url="/pages/funds/index">我的预收与资金流水 →</navigator></view>
  <button class="secondary" bindtap="back">返回服务中心</button>
  <view class="page-footnote">付款或退款请联系原门店前台；本页不发起支付。</view>
</view>
