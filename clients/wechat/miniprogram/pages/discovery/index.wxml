<view class="page">
  <view class="service-hero"><view class="brand">ADC 口腔 · 附近门店</view><view class="title">找到方便到达的门店</view><view class="hero-note">先看位置、营业安排和服务，再登录预约。</view></view>
  <view class="card"><view class="label">选择城市</view><picker range="{{cities}}" value="{{cityIndex}}" bindchange="city"><view class="picker">{{cities[cityIndex]}} ▾</view></picker><label class="label" for="clinic-keyword">区域或门店名称</label><input id="clinic-keyword" value="{{keyword}}" bindinput="keyword" placeholder="例如：梅溪湖、星沙" maxlength="80"/><button class="primary" bindtap="locate" loading="{{locating}}" disabled="{{locating}}">使用当前位置 · 由近到远</button><view class="muted line">{{locationNote}}</view></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{busy}}" class="notice">正在读取门店资料…</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view class="clinic-card-top"><text class="status">{{item.opening.state_label}}</text><text class="fee">{{item.distanceLabel}}</text></view>
    <view class="section-title">{{item.name}}</view><view class="muted">{{item.city}} · {{item.district}}</view><view class="line">{{item.address}}</view><view class="muted">{{item.entrance}}</view>
    <view class="line">联系电话 {{item.phone}}</view><view class="line">今日营业 {{item.opening.today}}</view>
    <view class="hours-grid"><view wx:for="{{item.opening.week}}" wx:for-item="day" wx:key="day">{{day.day}} {{day.hours}}</view></view>
    <view wx:for="{{item.opening.notices}}" wx:for-item="notice" wx:key="start" class="notice">{{notice.text}}</view>
    <view class="action-row"><button class="secondary" bindtap="contact" data-id="{{item.id}}" data-action="call">联系门店</button><button class="secondary" bindtap="contact" data-id="{{item.id}}" data-action="map">查看位置</button></view>
    <view class="label">本店服务</view><button wx:for="{{item.services}}" wx:for-item="service" wx:key="id" bindtap="openService" data-id="{{service.id}}" class="secondary">{{service.name}} →</button><view wx:if="{{!item.services.length}}" class="muted">服务安排正在准备，请联系前台。</view><view class="muted line">营业不代表有空余号源，选择服务后核对医师与时间。</view>
  </view>
  <view wx:if="{{!busy && !rows.length}}" class="notice">所选城市或区域暂无匹配门店，请更换城市或清除搜索条件。</view>
  <button bindtap="services" class="secondary">了解全部诊疗服务</button><button bindtap="account" class="primary">登录查看我的预约</button><button bindtap="load" class="secondary" disabled="{{busy}}">更新门店资料</button><view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
