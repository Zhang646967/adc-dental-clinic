<view class="page patient-flow">
  <view class="identity-bar">
    <view class="identity-main">
      <block wx:if="{{serviceState==='ready'}}"><text class="identity-name">{{patientName||'请先选择'}}</text><text class="identity-meta">{{patientCapacity}}<text wx:if="{{patientDelegated}}"> · 代约</text></text></block>
      <text wx:elif="{{serviceState==='loading'}}">正在核对就诊人…</text>
      <text wx:elif="{{serviceState==='guest'}}">访客可先浏览公开门店与服务</text>
      <text wx:elif="{{serviceState==='enrollment'}}">账号待前台核验</text>
      <text wx:elif="{{serviceState==='subject'}}">请选择本次就诊人</text>
      <text wx:elif="{{serviceState==='medical'}}">当前为独立医疗代理</text>
      <text wx:else>暂时无法核对就诊人</text>
    </view>
    <view class="identity-actions">
      <button wx:if="{{serviceState==='ready'}}" class="compact secondary" bindtap="subjects">切换</button>
      <button wx:if="{{serviceState==='ready'}}" class="compact secondary" bindtap="account">我的</button>
      <button wx:if="{{serviceState==='guest'}}" class="compact secondary" bindtap="login">登录／注册</button>
      <button wx:if="{{serviceState==='enrollment'}}" class="compact secondary" bindtap="account">核验进度</button>
      <button wx:if="{{serviceState==='subject'}}" class="compact secondary" bindtap="subjects">选择就诊人</button>
      <button wx:if="{{serviceState==='medical'}}" class="compact secondary" bindtap="medical">医疗授权</button>
      <button wx:if="{{serviceState==='error'}}" class="compact secondary" bindtap="retryService">重新核对</button>
    </view>
  </view>

  <view class="page-heading"><view class="title">患者服务中心</view></view>

  <view class="directory-shortcuts">
    <button class="secondary" bindtap="stores" disabled="{{locating}}">找门店</button>
    <button class="secondary" bindtap="doctors">找医师</button>
    <button class="secondary" bindtap="services">找服务</button>
  </view>
  <view wx:if="{{serviceError}}" class="error" role="alert">{{serviceError}}<text wx:if="{{serviceRequestId}}" class="support-code" selectable>查询编号 {{serviceRequestId}}</text></view>

  <view wx:if="{{serviceState==='ready'&&primary}}" class="card next-card primary-card">
    <view class="section-label">{{primary.label}}</view>
    <view wx:if="{{primary.timeLabel}}" class="time">{{primary.timeLabel}}<text class="tz"> 北京时间</text></view>
    <view wx:if="{{primary.detail}}">{{primary.detail}}</view>
    <view wx:if="{{primary.serviceLine}}" class="muted">{{primary.serviceLine}}</view>
    <view wx:if="{{primary.visitNo}}" class="muted">预约编号</view>
    <view wx:if="{{primary.visitNo}}" class="muted primary-visit-no">{{primary.visitNo}}</view>
    <view wx:if="{{primary.deadline}}" class="deadline">{{primary.deadline}}</view>
    <view wx:if="{{primary.arrived}}" class="notice">已到诊表示前台完成登记；医师实际接诊与治疗进展以现场指引和已发布的诊疗记录为准。</view>
    <view wx:if="{{primary.contact}}" class="notice">本次办理结果需由门店核实，请通过下方入口联系本单门店。</view>
    <view wx:if="{{primary.review}}" class="notice">请联系门店核实</view>
    <view class="muted">{{primary.hint}}</view>
    <button class="primary" bindtap="primaryTap">{{primary.actionLabel}}</button>
  </view>
  <view wx:if="{{serviceState==='ready'&&!primary&&!serviceError&&!readOnly}}" class="card"><view class="section-title">预约就诊</view><view class="muted">选择服务和时间，提交后可在这里查看到诊安排。</view><button class="primary" bindtap="book">预约就诊</button></view>

  <view wx:if="{{serviceState==='enrollment'}}" class="card"><view class="section-title">本人档案待前台核验</view><view class="muted">核验完成后可预约、查看到诊与费用。</view><button class="primary" bindtap="account">查看资料核验进度</button></view>
  <view wx:if="{{serviceState==='subject'}}" class="card"><view class="section-title">请选择就诊人</view><view class="muted">选择本次要办理的已核验就诊人。</view><button class="primary" bindtap="subjects">选择就诊人</button></view>
  <view wx:if="{{serviceState==='medical'}}" class="card"><view class="section-title">独立医疗代理</view><view class="muted">请从医疗授权入口查看可办理范围。</view><button class="primary" bindtap="medical">查看医疗授权</button></view>

  <block wx:if="{{serviceState==='ready'&&!serviceError}}">
    <view class="section-heading"><view class="section-title">常用办理</view></view>
    <view class="card shortcut-grid">
      <button wx:if="{{!readOnly&&primary&&primary.kind!=='BOOK'}}" class="shortcut" bindtap="book">预约就诊</button>
      <button class="shortcut" bindtap="arrangements">到诊安排</button>
      <button wx:if="{{reportEntry}}" class="shortcut" bindtap="reports">报告与复诊<text wx:if="{{reportUnread}}"> · {{reportUnread}}</text></button>
      <button wx:if="{{canViewFunds}}" class="shortcut" bindtap="fees">我的账单</button>
      <button class="shortcut" bindtap="records">{{patientDelegated?'预约记录':'就诊记录'}}</button>
    </view>
    <view class="card more-card">
      <button class="disclosure" bindtap="toggleMore" aria-expanded="{{moreOpen}}" aria-label="{{moreOpen?'收起更多服务与帮助':'展开更多服务与帮助'}}">更多服务与帮助 {{moreOpen?'收起':'展开'}}</button>
      <view wx:if="{{moreOpen}}" class="task-links more-links">
        <navigator url="/pages/waitlist/index">我的候补<text wx:if="{{overview.waiting_count}}"> · {{overview.waiting_count}} 条</text></navigator>
        <navigator wx:if="{{!patientDelegated&&canViewFunds}}" url="/pages/plans/index">治疗方案与本人决定</navigator>
        <navigator wx:if="{{!patientDelegated&&canViewFunds}}" url="/pages/funds/index">预收与资金流水</navigator>
        <navigator wx:if="{{!patientDelegated&&canViewFunds}}" url="/pages/record-copies/index">病历副本申请与领取</navigator>
        <navigator wx:if="{{!patientDelegated}}" url="/pages/history/index">健康自述与过敏复核</navigator>
        <navigator wx:if="{{!patientDelegated}}" url="/pages/referrals/index">跨店转诊与披露</navigator>
        <navigator url="/pages/help/index">就诊帮助</navigator>
      </view>
    </view>
  </block>

  <view id="store-search" class="card">
    <view class="section-title">{{nearbyActive?'附近门店':'门店目录'}}</view>
    <view class="muted">{{locationNote}}</view>
    <view class="filter-actions">
      <button wx:if="{{locationDenied}}" class="compact secondary" open-type="openSetting" bindopensetting="locationSettings">位置授权设置</button>
      <button wx:else class="compact secondary" bindtap="locate" loading="{{locating}}" disabled="{{locating}}">{{nearbyActive?'重新定位':'使用当前位置'}}</button>
      <button class="compact secondary" bindtap="toggleFilters" aria-expanded="{{filtersOpen}}">{{filtersOpen?'收起筛选':'选城市或筛选'}}</button>
    </view>
    <view wx:if="{{filtersOpen}}">
      <view class="filter-grid">
        <view><view class="label">就诊城市</view><picker range="{{cities}}" value="{{cityIndex}}" bindchange="city"><view class="picker">{{cities[cityIndex]}} ▾</view></picker></view>
        <view><view class="label">服务类别</view><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex].name}} ▾</view></picker></view>
      </view>
      <input value="{{keyword}}" bindinput="keyword" placeholder="搜索区域或门店名称" maxlength="80" aria-label="搜索区域或门店名称"/>
      <label class="small">仅看可线上预约的门店 <switch checked="{{onlineOnly}}" bindchange="online"/></label>
    </view>
  </view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button class="secondary" bindtap="load">重新连接</button></view>
  <view wx:if="{{busy}}" class="notice">正在读取门店资料…</view>
  <view wx:if="{{!busy&&!error}}" class="section-heading"><view class="section-label">共 {{count}} 家门店</view></view>
  <view wx:for="{{rows}}" wx:key="id" class="card branch-card">
    <view class="clinic-card-top"><view class="section-title">{{item.name}}</view><text wx:if="{{item.distanceLabel}}" class="distance">{{item.distanceLabel}}</text></view>
    <view class="line">{{item.address || item.district || item.city}}</view>
    <view class="muted"><text wx:if="{{item.opening.state_label}}">{{item.opening.state_label}}　</text>{{item.opening.today}}</view>
    <button class="secondary" bindtap="clinic" data-id="{{item.id}}" aria-label="查看{{item.name}}详情">查看门店</button>
  </view>
  <view wx:if="{{!busy&&!error&&!rows.length}}" class="notice">没有符合条件的门店。可更换城市或调整筛选。</view>
  <button wx:if="{{hasMore}}" class="secondary" bindtap="more">查看更多门店</button>
  <view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
