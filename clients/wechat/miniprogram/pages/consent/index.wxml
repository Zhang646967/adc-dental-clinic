<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="title">医疗告知与本人决定</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{done}}" class="notice">{{done}}</view><view wx:if="{{busy}}" class="notice">正在核对…</view>
<block wx:if="{{medical}}"><view class="card"><view class="section-title">{{medical.clinic}} · {{medical.status}}</view><view>{{medical.description}}<text wx:if="{{medical.tooth}}"> · FDI {{medical.tooth}} {{medical.surface}}</text></view><view wx:if="{{medical.version}}">告知 V{{medical.revision}} · 方案 V{{medical.plan_version}} · {{medical.is_current?'最新告知':'历史告知'}}</view><view>{{medical.identity_basis}}</view><view>{{medical.doctor}} {{medical.timeLabel}}</view><view class="notice">{{medical.applicability}}</view><view class="muted">{{medical.evidence_notice}}</view><navigator url="/pages/plan/index?id={{medical.plan}}">返回方案与步骤 →</navigator></view>
<view class="row"><button wx:for="{{medical.versions}}" wx:key="revision" class="secondary" data-step="{{item.step}}" data-revision="{{item.revision}}" bindtap="version" disabled="{{busy||uncertain}}">告知 V{{item.revision}}</button></view>
<view class="card"><view class="section-title">具体治疗说明</view><view wx:for="{{medical.disclosure.fields}}" wx:key="key" class="line"><view class="label">{{item.label}}</view><view>{{item.value}}</view></view><view wx:if="{{!medical.disclosure.available}}">尚无已确认的本步骤治疗说明，请联系负责医师。</view></view>
<view class="card"><view class="section-title">沟通与决定历史</view><view wx:for="{{medical.events}}" wx:key="id" class="line"><view class="label">#{{item.id}} · {{item.label}} · 告知 V{{item.revision}}</view><view>{{item.source_label}}<text wx:if="{{item.unanswered}}"> · 待医师答复</text><text wx:if="{{item.reply_to}}"> · 答复问题 #{{item.reply_to}}</text></view><view>{{item.text}}</view><view wx:if="{{item.reference}}">原件参考 {{item.reference}}</view><view class="muted">实际 {{item.timeLabel}} · 登记 {{item.recordedLabel}}</view></view><view wx:if="{{!medical.events.length}}">尚无医疗沟通记录。</view></view>
<view wx:if="{{medical.version && !readOnly}}" class="card"><view class="section-title">表达我的决定或问题</view><view>同意不自动开始治疗；拒绝、暂缓或撤回不会自动取消预约、删除记录或退款。</view><picker range="{{actions}}" range-key="label" value="{{actionIndex}}" bindchange="change" disabled="{{busy||uncertain}}"><view class="picker">{{actions[actionIndex].label}} ▼</view></picker><label for="consent-text">问题／原因／沟通说明</label><textarea id="consent-text" value="{{text}}" maxlength="2000" bindinput="input" disabled="{{busy||uncertain}}"/><button bindtap="preview" disabled="{{busy||uncertain||(actions[actionIndex].code==='AGREED'&&!medical.can_agree)||(actions[actionIndex].code==='WITHDRAWN'&&!medical.can_withdraw)}}">预览我的表达</button></view>
<view wx:if="{{preview}}" class="card"><view class="section-title">{{preview.label}}</view><view>告知 V{{medical.revision}} · {{medical.description}}</view><view>{{preview.values.text}}</view><checkbox-group bindchange="checked"><label><checkbox value="yes" checked="{{checked}}" disabled="{{busy||uncertain}}"/>已核对具体内容、版本及本人表达</label></checkbox-group><view wx:if="{{uncertain}}" class="notice">刚才的结果尚未确认。可核对历史，或重试同一提交。</view><button bindtap="confirm" disabled="{{busy}}">{{uncertain?'重试核对原提交':'明确确认并保留'}}</button><button class="secondary" bindtap="cancel" disabled="{{busy||uncertain}}">返回核对</button></view></block><button class="secondary" bindtap="load" disabled="{{busy||uncertain}}">刷新当前记录</button></view>
