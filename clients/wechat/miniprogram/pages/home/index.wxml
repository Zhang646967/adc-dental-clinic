<view class="page patient-flow {{textScale}}">
  <view wx:if="{{subjectInvalid}}" class="card">
    <view class="section-title">请重新选择就诊人</view>
    <view class="line">当前授权已变更。请选择就诊人后再查看记录。</view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text></view>
    <button class="primary" bindtap="subjects">重新选择就诊人</button>
  </view>
  <view wx:elif="{{guest||needsSubject||needsEnrollment}}" class="card">
    <view class="title">我的就诊</view>
    <view class="line">{{guest?'登录后可查看预约和就诊记录。':needsSubject?'选择本次要查看的就诊人。':'完成就诊人核验后可查看预约。'}}</view>
    <button wx:if="{{guest}}" class="primary" bindtap="login">登录／注册</button>
    <button wx:if="{{needsSubject}}" class="primary" bindtap="subjects">选择就诊人</button>
    <button wx:if="{{needsEnrollment}}" class="primary" bindtap="account">查看核验进度</button>
  </view>
  <block wx:else>
    <view class="page-heading"><view class="title">我的就诊</view></view>
    <view wx:if="{{patientName}}" class="subject-banner">
      <text>就诊人：{{patientName}}</text><text>{{patientCapacity}}</text>
      <navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator>
    </view>
    <view wx:if="{{readOnly}}" class="notice">当前仅可查看就诊安排。</view>
    <view wx:if="{{primary}}" class="card next-card primary-card">
      <view class="section-label">{{primary.label}}</view>
      <view wx:if="{{primary.timeLabel}}" class="time">{{primary.timeLabel}}<text class="tz"> 北京时间</text></view>
      <view wx:if="{{primary.detail}}" class="line">{{primary.detail}}</view>
      <view wx:if="{{primary.serviceLine}}" class="muted">{{primary.serviceLine}}</view>
      <view wx:if="{{primary.deadline}}" class="deadline">{{primary.deadline}}</view>
      <view wx:if="{{primary.hint && (primary.review || primary.kind!=='UPCOMING_VISIT')}}" class="muted">{{primary.hint}}</view>
      <button class="primary" bindtap="primaryTap">{{primary.actionLabel}}</button>
    </view>
    <view wx:if="{{!primary && overview.offer_count}}" class="attention">
      <view class="label">{{overview.offer_count}} 条限时邀约</view>
      <navigator class="link" url="/pages/waitlist/index">查看邀约与截止时间</navigator>
    </view>
    <view wx:if="{{!primary && overview.next_visit}}" class="card next-card">
      <view class="section-label">{{overview.next_visit.status==='CHECKED_IN'?'已到诊':'下一次就诊'}}</view>
      <view class="time">{{overview.next_visit.startLabel}}<text class="tz"> 北京时间</text></view>
      <view class="line">{{overview.next_visit.clinic}} · {{overview.next_visit.dentist}}</view>
      <view class="muted">{{overview.next_visit.service}} · {{overview.next_visit.status_label}}</view>
      <view wx:if="{{overview.next_visit.needs_outcome_review}}" class="notice">到诊结果待核实，请联系门店。</view>
      <button class="secondary" data-id="{{overview.next_visit.id}}" bindtap="open">查看到诊安排</button>
    </view>
    <navigator wx:if="{{reportEntry}}" class="card report-entry" url="/pages/report-notices/index" aria-label="{{reportUnread?'查看报告与复诊，'+reportUnread+'条未读':'查看报告与复诊'}}">
      <text class="section-label">查看报告与复诊</text>
      <text wx:if="{{reportUnread}}" class="pill">{{reportUnread}} 条未读</text>
      <text class="entry-chevron" aria-hidden="true">›</text>
    </navigator>
    <view wx:if="{{!busy && error}}" class="error" role="alert">
      {{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text>
      <button class="secondary" bindtap="onShow">重新读取</button>
    </view>
    <view wx:if="{{busy}}" class="notice">正在读取就诊安排…</view>
    <view wx:if="{{overview}}" class="card more-card">
      <button class="disclosure" bindtap="toggleServices" aria-expanded="{{servicesOpen}}">其他就诊服务 · {{servicesOpen?'收起':'展开'}}</button>
      <view wx:if="{{servicesOpen}}" class="task-links more-links">
        <navigator url="/pages/waitlist/index">我的候补<text wx:if="{{overview.waiting_count}}"> · {{overview.waiting_count}} 条</text></navigator>
        <navigator url="/pages/help/index">联系门店</navigator>
        <block wx:if="{{!patientDelegated}}">
          <navigator url="/pages/funds/index">我的预收与资金流水</navigator>
          <navigator url="/pages/record-copies/index">病历副本申请与领取</navigator>
          <navigator url="/pages/history/index">健康自述与过敏复核</navigator>
          <navigator url="/pages/plans/index">治疗方案与本人决定</navigator>
          <navigator url="/pages/referrals/index">跨店转诊与披露范围</navigator>
        </block>
      </view>
    </view>
    <view class="section-heading"><view class="section-title">就诊记录</view></view>
    <view class="row tabs">
      <button class="{{queue==='active'?'selected':''}}" data-queue="active" bindtap="changeQueue">待就诊与在诊</button>
      <button class="{{queue==='history'?'selected':''}}" data-queue="history" bindtap="changeQueue">历史记录</button>
      <button class="{{queue==='all'?'selected':''}}" data-queue="all" bindtap="changeQueue">全部</button>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="card visit-row">
      <view class="record-head"><view class="pill status-{{item.kind}}">{{item.status_label}}</view><text class="muted">#{{item.id}}</text></view>
      <view class="time">{{item.whenLabel}}<text class="tz"> 北京时间</text></view>
      <view class="line">{{item.clinic}}</view>
      <view class="muted">{{item.dentist}}<text wx:if="{{item.service}}"> · {{item.service}}</text></view>
      <view wx:if="{{item.needs_outcome_review}}" class="notice">到诊结果待核实，请联系门店。</view>
      <button class="secondary" data-id="{{item.id}}" bindtap="open">{{item.actionLabel}}</button>
      <button class="disclosure" data-id="{{item.id}}" bindtap="toggleRow" aria-expanded="{{item.open}}" aria-label="{{item.open?'收起'+item.detailLabel:'展开'+item.detailLabel}}">{{item.open?'收起':'展开'}}{{item.detailLabel}}</button>
      <view wx:if="{{item.open}}" class="detail-panel">
        <view class="muted">完整编号</view><view class="prose checkout-id">{{item.numberLabel}}</view>
        <view wx:if="{{item.note}}" class="muted">{{item.note}}</view>
      </view>
    </view>
    <view wx:if="{{!busy && !rows.length && !error}}" class="card empty">
      <view class="section-title">{{queue==='history'?'暂无历史就诊':(queue==='all'?'暂无就诊记录':'暂无待到诊的预约')}}</view>
      <button wx:if="{{queue!=='history' && !readOnly && !primary}}" class="primary" bindtap="book">预约就诊</button>
    </view>
    <view wx:if="{{pages>1}}" class="row">
      <button disabled="{{page<=1 || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{page>=pages || busy}}" data-step="1" bindtap="turn">下一页</button>
    </view>
    <button wx:if="{{!error && overview}}" class="disclosure" bindtap="load" disabled="{{busy}}">刷新就诊记录</button>
    <view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
  </block>
</view>
