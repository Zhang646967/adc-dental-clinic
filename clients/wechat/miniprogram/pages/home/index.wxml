<view class="page"><view wx:if="{{guest||needsSubject||needsEnrollment}}" class="card"><view class="section-title">就诊安排集中在这里</view><view class="line">登录并选择已核验的就诊人后，可以管理预约、候补和本人记录。</view><button wx:if="{{guest}}" class="primary" bindtap="login">登录／注册</button><button wx:if="{{needsSubject}}" class="primary" bindtap="subjects">选择就诊人</button><button wx:if="{{needsEnrollment}}" class="primary" bindtap="account">查看本人资料核验进度</button></view><block wx:else><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view>
  <view class="page-heading"><view class="title">我的就诊</view><view class="muted">查看到诊安排、预约记录与待办。</view></view>
  <view wx:if="{{readOnly}}" class="notice">当前环境仅供查看，暂不办理预约变更。</view>
  <view wx:if="{{overview.offer_count}}" class="attention"><view class="label">有 {{overview.offer_count}} 条邀约待你确认</view><view>时段为限时保留，请先查看截止时间，再决定是否接受。</view><navigator class="link" url="/pages/waitlist/index">立即查看邀约 →</navigator></view>
  <view wx:if="{{overview.next_visit}}" class="card next-card"><view class="section-label">{{overview.next_visit.status==='CHECKED_IN'?'正在就诊':'下一次就诊'}}</view><view class="time">{{overview.next_visit.startLabel}}</view><view>{{overview.next_visit.clinic}} · {{overview.next_visit.dentist}}</view><view class="muted">{{overview.next_visit.service}} · {{overview.next_visit.status_label}}</view><button class="secondary" data-id="{{overview.next_visit.id}}" bindtap="open">查看安排与到诊提示</button></view>

  <view wx:if="{{!busy && error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text><button class="secondary" bindtap="onShow">重新读取</button></view>
  <view wx:if="{{busy}}" class="notice">正在读取就诊安排…</view>
  <view wx:if="{{overview}}" class="card patient-section task-links">
    <view class="section-title">办理与查询</view>
    <navigator url="/pages/waitlist/index">我的候补<text wx:if="{{overview.waiting_count}}"> · {{overview.waiting_count}} 条</text></navigator>
    <navigator wx:if="{{!patientDelegated}}" url="/pages/record-copies/index">病历副本申请与领取</navigator>
    <navigator url="/pages/help/index">联系门店</navigator>
  </view>
  <view class="section-heading"><view class="section-title">预约与历史就诊</view></view>
  <view class="row tabs"><button class="{{queue==='active'?'selected':''}}" data-queue="active" bindtap="changeQueue">待就诊与在诊</button><button class="{{queue==='history'?'selected':''}}" data-queue="history" bindtap="changeQueue">历史记录</button><button class="{{queue==='all'?'selected':''}}" data-queue="all" bindtap="changeQueue">全部</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view class="pill">{{item.status_label}}</view><view class="time">{{item.startLabel}}</view><view>至 {{item.endLabel}}</view>
    <view class="line">{{item.clinic}} · {{item.dentist}}</view><view>{{item.service}}</view>
    <button class="secondary" data-id="{{item.id}}" bindtap="open">{{queue==='history' && !patientDelegated?'查看就诊与结算':'查看预约'}}</button>
  </view>
  <view wx:if="{{!busy && !rows.length && !error}}" class="card empty"><view class="section-title">{{queue==='history'?'暂无历史就诊':'暂无预约安排'}}</view><button wx:if="{{queue!=='history' && !readOnly}}" class="primary" bindtap="book">预约就诊</button></view>
  <view wx:if="{{pages>1}}" class="row"><button disabled="{{page<=1 || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{page>=pages || busy}}" data-step="1" bindtap="turn">下一页</button></view>
  <button class="secondary" bindtap="load" disabled="{{busy}}">刷新办理结果</button>
<view class="card"><view class="section-title">本人的健康与诊疗</view><view wx:if="{{patientDelegated}}" class="muted">当前为代约身份，可管理授权预约；临床与结算资料由患者本人查看。</view><view wx:else class="task-links"><navigator url="/pages/history/index">健康自述与过敏复核 →</navigator><navigator url="/pages/plans/index">治疗方案与本人决定 →</navigator><navigator url="/pages/referrals/index">跨店转诊与披露范围 →</navigator><view class="muted">本人结算单可从历史就诊详情查看。</view></view></view><view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view></block></view>
