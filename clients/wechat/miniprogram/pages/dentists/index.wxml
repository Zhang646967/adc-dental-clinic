<view class="page"><view class="service-hero"><view class="brand">ADC口腔 · 接诊团队</view><view class="title">选择适合的医师</view><view class="hero-note">了解专业方向和接诊门店，再核对预约时间。</view></view><view class="card"><view class="label">城市</view><picker disabled="{{busy}}" range="{{cities}}" value="{{cityIndex}}" bindchange="city"><view class="picker">{{cities[cityIndex]}} ▾</view></picker><view class="label">服务方向</view><picker disabled="{{busy}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex].name}} ▾</view></picker><label class="label" for="doctor-search">医师或专业关键词</label><input id="doctor-search" value="{{keyword}}" bindinput="keyword" bindconfirm="search" maxlength="80" placeholder="例如：医师姓名、复诊"/><label class="line">未来十四天有出诊 <switch checked="{{scheduled}}" bindchange="scheduled"/></label><button class="primary" bindtap="search" disabled="{{busy}}">查找医师</button></view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="profile-person"><image wx:if="{{item.portrait}}" src="{{item.portrait}}" class="profile-avatar" mode="aspectFill"/><view><view class="section-title">{{item.name}}</view><view class="muted">{{item.title}} · {{item.languages}}</view></view></view><view class="line">{{item.summary}}</view><view class="profile-tags"><text wx:for="{{item.specialty_labels}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view><view wx:for="{{item.clinics}}" wx:for-item="branch" wx:key="id" class="muted line">{{branch.name}}</view><button class="secondary" bindtap="doctor" data-id="{{item.id}}">了解医师与出诊 →</button></view><view wx:if="{{!busy&&!rows.length}}" class="notice">暂无匹配医师，请调整筛选条件。</view><view class="card"><view>{{page}} / {{pages}}</view><button wx:if="{{page>1}}" bindtap="previous" disabled="{{busy}}">上一页</button><button wx:if="{{page<pages}}" bindtap="next" disabled="{{busy}}">下一页</button></view></view>
