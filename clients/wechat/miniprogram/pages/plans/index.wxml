<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="title">我的治疗计划</view><view class="notice">核对已讨论版本和本人决定。计划估算不等于实际治疗或账单。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{busy}}" class="notice">正在核对本人方案…</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="section-title">{{item.clinic}} · V{{item.version}}</view><view class="line">{{item.summary}}</view><view class="muted">{{item.timeLabel}}</view><button class="secondary" data-id="{{item.id}}" bindtap="open">查看步骤与本人决定</button></view><view wx:if="{{!busy && !rows.length && !error}}" class="card">尚无已确认方案。请在接诊时与负责医师核对。</view><view class="row"><button disabled="{{page<=1 || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{page>=pages || busy}}" data-step="1" bindtap="turn">下一页</button></view><button class="secondary" bindtap="load" disabled="{{busy}}">刷新方案</button></view>
