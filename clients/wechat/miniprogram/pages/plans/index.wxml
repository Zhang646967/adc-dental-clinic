<import src="../../templates/patient-results.wxml"/>
<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="page-heading"><view class="title">治疗方案</view><view class="subtitle">查看版本、已记录选择和下一步安排。</view></view><template is="patient-results" data="{{busy, error, requestId, done}}"/><view class="notice">核对已讨论版本和本人决定。计划估算不等于实际治疗或账单。</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="section-title">{{item.clinic}} · V{{item.version}}</view><view class="line">{{item.summary}}</view><view class="muted">{{item.timeLabel}}</view><button class="secondary" data-id="{{item.id}}" bindtap="open">查看步骤与本人决定</button></view><view wx:if="{{!busy && !rows.length && !error}}" class="card">尚无已确认方案。请在接诊时与负责医师核对。</view><view wx:if="{{pages>1}}" class="row"><button disabled="{{page<=1 || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{page>=pages || busy}}" data-step="1" bindtap="turn">下一页</button></view><button class="secondary" bindtap="onShow" disabled="{{busy}}">查询方案结果</button><view class="patient-return"><navigator class="link" open-type="switchTab" url="/pages/home/index">返回就诊</navigator></view></view>
