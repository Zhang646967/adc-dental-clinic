<view class="page"><view class="brand">核对后再提交</view><view class="title">{{done?'办理结果':title}}</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{done}}" class="card"><view class="pill">{{done.status_label}}</view><view class="time">{{done.startLabel}}</view><view>{{done.clinic}} · {{done.dentist}}</view><view>{{doneType==='waitlist'?'候补':'预约'}}编号 #{{done.id}}</view><view wx:if="{{doneType==='waitlist'}}" class="notice">请以候补当前状态为准；尚未成约时不按预约到诊。</view><button class="primary" bindtap="result">{{doneType==='waitlist'?'查看候补进展':'查看这条预约'}}</button></view>
  <block wx:elif="{{review}}">
    <view wx:if="{{review.preview.original}}" class="card"><view class="pill">{{review.kind==='cancel'?'将取消的预约':'原预约'}}</view><view>{{review.preview.original.clinic}} · {{review.preview.original.dentist}}</view><view>{{review.preview.original.startLabel}} 至 {{review.preview.original.endLabel}}</view></view>
    <view wx:if="{{review.preview.wait}}" class="card"><view>{{review.preview.wait.clinic}} · {{review.preview.wait.service}}</view><view class="pill">候补 #{{review.preview.wait.id}} · {{review.preview.wait.status_label}}</view></view>
    <view wx:elif="{{review.kind!=='cancel'}}" class="card"><view class="pill">{{review.kind==='reschedule'?'新的安排':review.kind==='wait_join'?'可接受范围':'本次安排'}}</view><view>{{review.preview.clinic}} · {{review.preview.dentist}}</view><view class="time">{{review.preview.startLabel}}</view><view>至 {{review.preview.endLabel}}</view><view>{{review.preview.service}}</view></view>
    <view wx:if="{{review.kind==='booking' || review.kind==='wait_join'}}" class="card"><view class="label">费用说明</view><view class="fee">{{review.preview.fee_label}}</view><view class="prose">{{review.preview.fee_note}}</view><view class="label">到诊准备</view><view class="prose">{{review.preview.preparation}}</view><view wx:if="{{review.preview.patient_request}}" class="label">本次就诊需求</view><view wx:if="{{review.preview.patient_request}}" class="prose">{{review.preview.patient_request}}</view></view>
    <view wx:if="{{review.preview.reason}}" class="notice">办理原因：{{review.preview.reason}}</view>
    <view wx:if="{{review.preview.duration_changed}}" class="notice">当前服务时长与原预约不同，请特别核对结束时间。</view>
    <view class="notice">{{note}}</view><view class="muted">时间均为北京时间。预约及候补操作不产生治疗或收费。</view>
    <checkbox-group bindchange="checked"><label class="check"><checkbox value="yes" checked="{{checked}}"/><text>{{consent}}</text></label></checkbox-group>
    <button class="{{review.kind==='cancel' || review.kind==='wait_withdraw' || review.kind==='offer_decline'?'danger':'primary'}}" disabled="{{!checked || busy}}" loading="{{busy}}" bindtap="submit">{{button}}</button>
  </block><button class="secondary" bindtap="home">返回我的预约核对结果</button>
</view>
