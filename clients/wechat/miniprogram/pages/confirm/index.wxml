<view class="page patient-flow {{textScale}}"><view wx:if="{{!subjectInvalid}}" class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><button class="link-button" bindtap="subjects" disabled="{{busy||querying}}">切换就诊人</button></view><view wx:if="{{review.kind==='booking'}}" class="steps">第 3 步 · 核对提交</view><view class="title">{{done?'办理结果':uncertain?'本次预约结果':conflict?conflictTitle:otherFailed?'本次操作未保存':otherUnconfirmed?'本次操作结果':subjectInvalid?'请重新核对就诊人':title||'核对就诊安排'}}</view>
  <view wx:if="{{error||requestId}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text></view>
  <button wx:if="{{subjectInvalid}}" class="primary" bindtap="recoverSubject" disabled="{{busy}}" loading="{{busy}}">核对账号与就诊人</button>
  <view wx:if="{{done}}" class="card"><view class="pill">{{done.status_label}}</view><view class="time">{{done.startLabel}}<text class="tz"> 北京时间</text></view><view>{{done.clinic}} · {{done.dentist}}</view><view>{{doneType==='waitlist'?'候补':'预约'}}编号 #{{done.id}}</view><view wx:if="{{doneType==='waitlist'}}" class="notice">请以候补当前状态为准；尚未成约时不按预约到诊。</view><button class="primary" bindtap="result">{{doneType==='waitlist'?'查看候补进展':'查看这条预约'}}</button><button class="secondary" bindtap="home">返回预约清单</button></view>
  <view wx:elif="{{uncertain}}" class="card result-pending"><view class="pill">结果暂未确认</view><view class="section-title">本次预约结果暂未确认</view><view class="prose">提交已经发出，但没有收到明确结果。查询只读取这次提交是否已保存，不会重复提交。</view><view wx:if="{{queryMessage}}" class="notice">{{queryMessage}}</view><button class="primary" bindtap="queryResult" loading="{{querying}}" disabled="{{querying||!canQuery}}">查询本次预约结果</button><button class="secondary" bindtap="home" disabled="{{querying}}">返回预约清单</button><view class="muted">也可以稍后从原预约、原就诊或预约清单核对。</view></view>
  <view wx:elif="{{conflict}}" class="card">
    <view class="prose">{{conflictMessage}}</view>
    <view wx:if="{{conflictKind==='reschedule'&&conflictOriginal}}" class="muted">可以打开原预约核对当前状态。</view>
    <button wx:if="{{!followupBlocked}}" class="primary" bindtap="backToSelection">重新选择时段</button>
    <button wx:if="{{followupBlocked}}" class="primary" bindtap="visitCheck">回到原就诊</button>
    <button wx:if="{{conflictKind==='reschedule'&&conflictOriginal}}" class="secondary" bindtap="openOriginal">核对原预约</button>
    <button class="secondary" bindtap="home">返回预约清单</button>
  </view>
  <view wx:elif="{{otherUnconfirmed}}" class="card"><view class="pill">{{otherFailed?'本次未保存':'结果暂未确认'}}</view><view class="section-title">{{otherFailed?'本次操作未保存':'本次操作结果暂未确认'}}</view><view class="prose">{{otherFailed?'提交没有保存，请到对应记录核对当前状态。':'提交已经发出，但没有收到明确结果。请到对应记录核对，不要重复提交。'}}</view><button class="primary" bindtap="openRecord">{{recordLabel}}</button><button class="secondary" bindtap="home">返回预约清单</button></view>
  <block wx:elif="{{review}}">
    <view wx:if="{{previewNote}}" class="preview-state">{{previewNote}}</view>
    <block wx:if="{{review.kind==='reschedule'}}">
      <view class="card reschedule-summary">
        <view class="muted compare-zone">{{comparison.summary.sharedDay}}<text wx:if="{{comparison.summary.sharedDay}}"> · </text>北京时间</view>
        <view class="compare-row">
          <view class="label">原预约</view>
          <view class="time compare-time">{{comparison.summary.originalTime}}</view>
          <view wx:for="{{comparison.summary.originalOnly}}" wx:key="label" class="compare-fact">{{item.label}}　{{item.value}}</view>
          <view wx:if="{{comparison.summary.originalDuration}}" class="muted">原时长 {{comparison.summary.originalDuration}}</view>
        </view>
        <view class="compare-row compare-new">
          <view class="label">拟选的新安排</view>
          <view class="time compare-time">{{comparison.summary.proposedTime}}</view>
          <view wx:if="{{comparison.summary.doctorChanged}}" class="changed-duration">医师已变更</view>
          <view wx:for="{{comparison.summary.proposedOnly}}" wx:key="label" class="compare-fact">{{item.label}}　{{item.value}}</view>
          <view wx:if="{{comparison.summary.durationChanged}}" class="changed-duration">时长与原约不同<text wx:if="{{comparison.summary.proposedDuration}}"> · {{comparison.summary.proposedDuration}}</text></view>
          <view wx:elif="{{comparison.summary.proposedDuration}}" class="muted">预计 {{comparison.summary.proposedDuration}}</view>
        </view>
        <view wx:if="{{comparison.summary.shared.length}}" class="compare-shared">
          <view wx:for="{{comparison.summary.shared}}" wx:key="label" class="compare-fact"><text class="muted compare-label">{{item.label}}</text><text>{{item.value}}</text></view>
        </view>
      </view>
      <button class="disclosure compare-disclosure" bindtap="toggleRescheduleDetails" aria-expanded="{{detailsOpen}}" disabled="{{busy}}">{{detailsOpen?'收起改期详情':'查看改期详情'}}</button>
      <view wx:if="{{detailsOpen}}" class="card compare-details">
        <block wx:if="{{comparison.original.visitNo || comparison.original.id}}"><view class="label">原预约<text wx:if="{{comparison.original.id}}"> #{{comparison.original.id}}</text></view>
          <view wx:if="{{comparison.original.visitNo}}" class="checkout-id" selectable>{{comparison.original.visitNo}}</view></block>
        <view wx:if="{{comparison.summary.originalDentistDetail}}" class="compare-fact">原约医师　{{comparison.summary.originalDentistDetail}}</view>
        <view wx:if="{{comparison.original.statusLabel}}" class="compare-fact">原预约状态　{{comparison.original.statusLabel}}</view>
        <view wx:if="{{review.preview.reason}}" class="compare-fact">改期原因　{{review.preview.reason}}</view>
        <view class="muted">改期成功后，其他候补仍保留。本次改期不产生费用。</view>
      </view>
    </block>
    <block wx:else>
    <view wx:if="{{comparison.original}}" class="card">
      <view class="record-head"><view class="pill">{{review.kind==='cancel'?'将取消的预约':'原预约'}} #{{comparison.original.id}}</view><view class="pill status-upcoming">{{comparison.original.statusLabel||'已预约'}}</view></view>
      <view class="section-title">{{comparison.original.clinic}}</view>
      <view>{{comparison.original.dentist}}<text wx:if="{{comparison.original.serviceLabel}}"> · {{comparison.original.serviceLabel}}</text></view>
      <view class="time"><text class="nowrap">{{comparison.original.startLabel}}</text> 至 <text class="nowrap">{{comparison.original.endLabel}}</text><text class="tz"> 北京时间</text></view>
      <view wx:if="{{comparison.original.visitNo}}" class="muted">预约编号</view><view wx:if="{{comparison.original.visitNo}}" class="prose checkout-id">{{comparison.original.visitNo}}</view>
    </view>
    <view wx:elif="{{review.preview.original}}" class="card"><view class="pill">{{review.kind==='cancel'?'将取消的预约':'原预约'}}</view><view>{{review.preview.original.clinic}} · {{review.preview.original.dentist}}</view><view>{{review.preview.original.startLabel}} 至 {{review.preview.original.endLabel}}<text class="tz"> 北京时间</text></view></view>
    <view wx:if="{{review.preview.wait}}" class="card"><view>{{review.preview.wait.clinic}} · {{review.preview.wait.service}}</view><view class="pill">候补 #{{review.preview.wait.id}} · {{review.preview.wait.status_label}}</view></view>
    <view wx:elif="{{review.kind!=='cancel'}}" class="card">
      <view class="record-head"><view class="pill">{{review.kind==='reschedule'?'拟选的新安排':review.kind==='wait_join'?'可接受范围':'本次安排'}}</view><view wx:if="{{comparison.proposed.durationChanged}}" class="pill status-rescheduled">时长与原约不同</view></view>
      <view class="section-title">{{comparison.proposed?comparison.proposed.clinic:review.preview.clinic}}</view>
      <view>{{comparison.proposed?comparison.proposed.dentist:review.preview.dentist}}<text wx:if="{{comparison.proposed&&comparison.proposed.serviceLabel}}"> · {{comparison.proposed.serviceLabel}}</text><text wx:elif="{{review.preview.service}}"> · {{review.preview.service}}</text></view>
      <view class="time">{{comparison.proposed?comparison.proposed.startLabel:review.preview.startLabel}}</view>
      <view>至 {{comparison.proposed?comparison.proposed.endLabel:review.preview.endLabel}}<text class="tz"> 北京时间</text></view>
      <view wx:if="{{comparison.proposed&&comparison.proposed.durationLabel}}" class="muted">预计 {{comparison.proposed.durationLabel}}</view>
    </view>
    </block>
    <view wx:if="{{review.kind==='booking' || review.kind==='wait_join'}}" class="card"><view class="label">费用说明</view><view class="fee">{{review.preview.fee_label}}</view><view class="prose">{{review.preview.fee_note}}</view><view class="label">到诊准备</view><view class="prose">{{review.preview.preparation}}</view><view wx:if="{{review.preview.patient_request}}" class="label">本次就诊需求</view><view wx:if="{{review.preview.patient_request}}" class="prose">{{review.preview.patient_request}}</view></view>
    <block wx:if="{{review.kind!=='reschedule'}}">
    <view wx:if="{{review.preview.reason}}" class="notice">办理原因：{{review.preview.reason}}</view>
    <view wx:if="{{review.preview.duration_changed}}" class="notice">当前服务时长与原预约不同，请特别核对结束时间。</view>
    <view class="notice">{{note}}</view><view class="muted">预约及候补操作不产生治疗或收费。</view>
    </block>
    <checkbox-group bindchange="checked"><label class="check"><checkbox value="yes" checked="{{checked}}"/><text>{{consent}}</text></label></checkbox-group>
    <button class="{{review.kind==='cancel' || review.kind==='wait_withdraw' || review.kind==='offer_decline'?'danger':'primary'}}" disabled="{{!checked || busy || followupBlocked}}" loading="{{busy}}" bindtap="submit">{{busy?'正在提交…':button}}</button>
    <button class="secondary" bindtap="backToSelection" disabled="{{busy}}">{{backLabel}}</button>
  </block>
  <button wx:if="{{!subjectInvalid&&!review&&!done&&!uncertain&&!conflict&&!otherUnconfirmed}}" class="secondary" bindtap="home">返回预约清单</button>
  <button wx:if="{{followupBlocked&&!conflict}}" class="secondary" bindtap="visitCheck">回到原就诊核对</button>
</view>
