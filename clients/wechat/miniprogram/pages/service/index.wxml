<view class="page patient-flow"><view wx:if="{{authenticated && !subjectRequired}}" class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{busy}}" class="notice">正在核对服务内容…</view>
  <block wx:if="{{service}}">
    <view class="service-hero"><view class="brand">{{service.category_label}}</view><view class="title">{{service.name}}</view><view class="hero-facts"><text>{{service.clinic_name}}</text><text wx:if="{{service.duration}}">约 {{service.duration}} 分钟</text><text wx:if="{{service.fee_label}}">{{service.fee_label}}</text></view><view class="hero-note">{{service.summary}}</view><button wx:if="{{service.self_booking}}" class="hero-button" disabled="{{readOnly || busy}}" bindtap="book">查看可约时间</button><button wx:else class="hero-button" disabled="{{busy}}" bindtap="contact">联系门店核验就诊人</button><view wx:if="{{service.fee_note}}" class="hero-fee">{{service.fee_note}}</view></view>
    <view class="card"><view class="section-title">适合谁</view><view class="prose">{{service.suitable_for}}</view></view>
    <view class="card"><view class="section-title">到店后会做什么</view><view class="prose">{{service.visit_content}}</view><view wx:if="{{service.limitations}}" class="label">需要另行确认</view><view wx:if="{{service.limitations}}" class="prose">{{service.limitations}}</view></view>
    <view class="card"><view class="section-title">到诊准备</view><view class="prose">{{service.preparation}}</view></view>
    <view class="card"><view class="section-title">到诊信息</view><view class="line">{{service.clinic_name}}</view><view class="line">{{service.address}}</view><view class="line">前台电话 {{service.phone || '请通过门店已公布的联系方式咨询'}}</view><view class="muted">{{service.department}}<text wx:if="{{service.duration}}"> · 约 {{service.duration}} 分钟</text></view><view class="label">本服务可选医师</view><view wx:for="{{service.dentists}}" wx:key="id" class="line">{{item.name}}</view></view>
    <view wx:if="{{!service.self_booking}}" class="notice">儿童就诊需由门店核验监护人与就诊人及陪同要求，请先联系门店。</view>
    <view wx:if="{{readOnly}}" class="notice">当前环境仅供查看，暂不办理预约。</view>
    <navigator class="link" url="/pages/help/index">联系前台协助</navigator>
  </block>
  <button class="secondary" bindtap="load" disabled="{{busy}}">重新核对服务</button><navigator open-type="switchTab" class="link" url="/pages/services/index">返回服务目录</navigator><view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
