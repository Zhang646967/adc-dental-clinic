<view class="page">
  <view wx:if="{{visit}}" class="subject-banner">
    <text>就诊人：{{patientName||'请先选择'}}</text>
    <view>{{patientCapacity}}</view>
    <navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator>
  </view>
  <view class="title">{{reviewView && reviewView.completedLabel ? '就诊详情' : '预约详情'}}</view>
  <view wx:if="{{error}}" class="error" role="alert">
    {{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text>
  </view>
  <button wx:if="{{subjectInvalid}}" class="primary" bindtap="recoverSubject" disabled="{{busy}}" loading="{{busy}}">核对账号与就诊人</button>

  <view wx:if="{{visit}}" class="card">
    <view class="pill">{{visit.status_label}} · #{{visit.id}}</view>
    <view class="line">{{visit.clinic}} · {{visit.dentist}}</view>
    <view>{{visit.service}}</view>
    <view class="divider"></view>
    <view>{{visit.address}}</view>
    <view class="line">前台电话 {{visit.phone}}</view>
    <view wx:if="{{visit.visit_no}}" class="invoice-line">
      <view class="muted">就诊编号</view>
      <view class="prose">{{visit.visit_no}}</view>
    </view>
    <view class="invoice-line">
      <view class="muted">计划时间</view>
      <view>{{visit.startLabel}} 至 {{visit.endLabel}}</view>
    </view>
    <view wx:if="{{reviewView}}" class="invoice-line">
      <view class="muted">实际到诊</view>
      <view>{{reviewView.attendedLabel || '尚未登记'}}</view>
    </view>
    <view wx:if="{{reviewView && reviewView.completedLabel}}" class="invoice-line">
      <view class="muted">就诊结束</view>
      <view>{{reviewView.completedLabel}}</view>
    </view>
  </view>

  <view wx:if="{{visit.patient_request}}" class="card">
    <view class="section-title">本次就诊需求</view>
    <view class="prose">{{visit.patient_request}}</view>
  </view>
  <view wx:if="{{visit.needs_outcome_review}}" class="notice">预约时间已过，请联系门店核实。</view>
  <view wx:if="{{reviewView && reviewView.care}}" class="card">
    <view class="section-title">本次就诊结果</view>
    <view class="pill">{{reviewView.care.outcomeLabel}}</view>
    <block wx:if="{{reviewView.care.treatments.length}}">
      <view class="section-label">实际处置</view>
      <view wx:for="{{reviewView.care.treatments}}" wx:key="key" class="invoice-line">
        <view>{{item.name}}</view>
        <view class="muted">{{item.quantity}} {{item.unit}}<text wx:if="{{item.noCharge}}"> · 本次不另计费</text></view>
      </view>
    </block>
    <block wx:if="{{reviewView.care.medications.length}}">
      <view class="section-label">发退药结算</view>
      <view wx:for="{{reviewView.care.medications}}" wx:key="key" class="invoice-line">
        <view>{{item.name}}</view>
        <view class="muted">发退药后 {{item.netQuantity}} {{item.unit}} · ¥{{item.amount}}</view>
      </view>
    </block>
  </view>
  <view wx:if="{{examinations.length}}" class="card">
    <view class="section-title">检查与报告</view>
    <view wx:for="{{examinations}}" wx:key="id" class="offer-block">
      <view class="section-label">{{item.project}}</view>
      <view class="prose">{{item.number}}</view>
      <view class="muted">{{item.label}}<text wx:if="{{item.revisionLabel}}"> · {{item.revisionLabel}}</text><text wx:if="{{item.releasedLabel}}"> · 发布 {{item.releasedLabel}}</text></view>
      <button wx:if="{{item.canOpen}}" class="secondary" data-id="{{item.id}}" data-revision="{{item.revision}}" bindtap="openExamination">查看检查报告</button>
    </view>
  </view>
  <view wx:if="{{reviewView && reviewView.settlement}}" class="card">
    <view class="section-title">本次结算</view>
    <view class="invoice-line">
      <view class="muted">结算单</view>
      <view class="prose">{{reviewView.settlement.invoiceNo}} · 第 {{reviewView.settlement.revision}} 版</view>
    </view>
    <view class="fact-row"><text>账单金额</text><text>¥{{reviewView.settlement.total}}</text></view>
    <view class="fact-row"><text>尚需支付</text><text>¥{{reviewView.settlement.remaining}}</text></view>
    <view class="fact-row"><text>应退余额</text><text>¥{{reviewView.settlement.refundDue}}</text></view>
    <view wx:if="{{reviewView.settlement.reviewPending}}" class="notice">有结算事项待复核，余额按当前已确认结果显示。</view>
    <button class="primary" bindtap="invoice">查看本次结算单</button>
  </view>
  <view wx:elif="{{visit && !patientDelegated}}" class="card">
    <button wx:if="{{visit.invoice_id}}" class="primary" bindtap="invoice">查看本人结算单</button>
    <view wx:else class="muted">结算单发布后可在这里查看费用和余额。</view>
  </view>
  <view wx:if="{{reviewView && reviewView.followups.length}}" class="card">
    <view class="section-title">复诊安排</view>
    <view wx:for="{{reviewView.followups}}" wx:key="id" class="offer-block">
      <view class="section-label">{{item.label}}</view>
      <view>{{item.service}}</view>
      <view wx:if="{{item.rangeLabel}}" class="muted">建议日期 {{item.rangeLabel}}</view>
      <view wx:if="{{item.overdue}}" class="notice">建议日期已过，请联系门店核对后续安排。</view>
      <block wx:if="{{item.appointment}}">
        <view class="invoice-line">
          <view class="muted">复诊编号</view>
          <view class="prose">{{item.appointment.visitNo}} · #{{item.appointment.id}}</view>
        </view>
        <view class="muted">{{item.appointment.startLabel}} · {{item.appointment.statusLabel}}</view>
        <button class="secondary" data-id="{{item.appointment.id}}" bindtap="openFollowup">查看复诊预约</button>
      </block>
      <button wx:if="{{item.needsContact}}" class="secondary" bindtap="contactClinic">联系原门店协助</button>
    </view>
  </view>
  <view wx:elif="{{reviewView && reviewView.completedLabel}}" class="muted">本次就诊暂无复诊指示。</view>

  <view wx:if="{{visit.can_change && !readOnly}}">
    <button class="primary" bindtap="reschedule">选择新的就诊安排</button>
    <button class="danger" bindtap="cancel">{{cancelOpen?'保留预约，收起取消':'需要取消这次预约'}}</button>
  </view>
  <view wx:if="{{visit.can_change && !readOnly && cancelOpen}}" class="card">
    <label class="label" for="reason">取消原因</label>
    <textarea id="reason" value="{{reason}}" maxlength="500" bindinput="reason" placeholder="请说明安排方面的原因" aria-label="取消原因"/>
    <button class="danger" bindtap="previewCancel" disabled="{{busy}}" loading="{{busy}}">核对取消内容</button>
  </view>
  <button wx:if="{{visit.predecessor}}" class="secondary" data-id="{{visit.predecessor}}" bindtap="related">查看改期前的预约</button>
  <button wx:if="{{visit.successor}}" class="secondary" data-id="{{visit.successor}}" bindtap="related">查看改期后的预约</button>
  <navigator wx:if="{{visit}}" class="link" url="/pages/help/index?visit={{visit.id}}">联系前台协助</navigator>
  <button wx:if="{{visit || (error && !subjectInvalid)}}" class="secondary" bindtap="load" disabled="{{busy}}">刷新预约详情</button>
  <button bindtap="home">返回我的预约</button>
  <view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
