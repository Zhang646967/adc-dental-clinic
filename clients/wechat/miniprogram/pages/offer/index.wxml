<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="brand">ADC · 限时邀约</view><view class="title">核对这次就诊安排</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{offer}}" class="card"><view class="pill">{{offer.status_label}}</view><view class="time">{{offer.startLabel}}</view><view>至 {{offer.endLabel}}</view><view class="line">{{offer.clinic}} · {{offer.dentist}}</view><view>{{offer.service}}</view><view wx:if="{{offer.active}}" class="deadline">确认截止 {{offer.expiresLabel}}（北京时间）</view><button wx:if="{{offer.visit}}" class="secondary" bindtap="visit">查看已形成的预约 · {{offer.visit.status_label}}</button></view>
<view wx:if="{{offer.active && !readOnly}}" class="card"><label class="label">本次接受邀约的用途</label><picker class="picker" range="{{choices}}" range-key="name" value="{{choice}}" bindchange="pick">{{choices[choice].name}}</picker><view wx:if="{{choices[choice].source}}"><view class="notice">确认成功后替代指定的原预约；失败或未提交时原约继续保留。</view><label class="label" for="reason">改期原因</label><textarea id="reason" maxlength="500" value="{{reason}}" bindinput="reason" aria-label="改期原因"/></view><button class="primary" bindtap="accept" disabled="{{busy}}">核对并接受安排</button><button class="secondary" bindtap="decline" disabled="{{busy}}">这次不合适，核对拒绝</button></view><view wx:if="{{offer && !offer.active}}" class="notice">这条邀约已处理或到期。请核对候补当前进展；原有预约不会自动取消。</view><navigator class="link" url="/pages/waitlist/index">返回候补进展</navigator></view>
