<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="brand">ADC · 患者服务</view><view class="title">我的健康自述</view><view class="subtitle">留下本人自述，接诊时由医师逐项核对。</view><view class="notice">不清楚时保留“尚未明确”。自述不会自动改变已复核的过敏资料，也不代表医师已核对。</view>
<view wx:if="{{!patientDelegated}}" class="card"><label class="label">既往健康情况</label><picker class="picker" range="{{states}}" range-key="label" value="{{medicalIndex}}" data-field="medical_status" bindchange="pick" disabled="{{busy||uncertain||readOnly}}">{{states[medicalIndex].label}}</picker><textarea class="input" aria-label="既往健康情况说明" placeholder="相关情况或仍不确定的事项" maxlength="2000" value="{{fields.medical_history}}" data-field="medical_history" bindinput="field" disabled="{{busy||uncertain||readOnly}}"/>
<label class="label">目前用药情况</label><picker class="picker" range="{{states}}" range-key="label" value="{{medicationIndex}}" data-field="medication_status" bindchange="pick" disabled="{{busy||uncertain||readOnly}}">{{states[medicationIndex].label}}</picker><textarea class="input" aria-label="用药说明" placeholder="药名、用药情况或仍不确定的事项" maxlength="2000" value="{{fields.medications}}" data-field="medications" bindinput="field" disabled="{{busy||uncertain||readOnly}}"/>
<label class="label">自述过敏情况</label><picker class="picker" range="{{states}}" range-key="label" value="{{allergyIndex}}" data-field="allergy_status" bindchange="pick" disabled="{{busy||uncertain||readOnly}}">{{states[allergyIndex].label}}</picker><textarea class="input" aria-label="自述过敏说明" placeholder="曾出现的情况或仍不确定的事项" maxlength="2000" value="{{fields.reported_allergies}}" data-field="reported_allergies" bindinput="field" disabled="{{busy||uncertain||readOnly}}"/>
<checkbox-group bindchange="checked"><label class="check"><checkbox value="yes" checked="{{checked}}" disabled="{{busy||uncertain||readOnly}}"/>确认这是本人自述，未知情况仍保留，接诊时由医师另行核对。</label></checkbox-group><button class="primary" loading="{{busy}}" disabled="{{busy||readOnly}}" bindtap="submit">{{uncertain?'重试核对本次保存':'保存新自述版本'}}</button></view>
<view wx:if="{{uncertain}}" class="notice">本次保存结果尚未确认。内容暂时保留，请重试核对同一次保存，或先查看下方已提交版本。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{done}}" class="notice" role="status">{{done}}</view><button class="secondary" disabled="{{busy}}" bindtap="refresh">查看最新已提交版本</button><view class="section-title">本人已提交的自述</view>
<view class="card" wx:for="{{rows}}" wx:key="id"><button class="secondary" data-id="{{item.id}}" bindtap="expand">第 {{item.revision}} 版 · {{item.timeLabel}}</button><view wx:if="{{expanded===item.id}}"><view class="label">既往健康：{{item.medicalLabel}}</view><text selectable="true">{{item.medical_history||'未补充说明'}}</text><view class="label">用药：{{item.medicationLabel}}</view><text selectable="true">{{item.medications||'未补充说明'}}</text><view class="label">自述过敏：{{item.allergyLabel}}</view><text selectable="true">{{item.reported_allergies||'未补充说明'}}</text></view></view><view class="notice" wx:if="{{!busy&&!rows.length&&!patientDelegated}}">尚无本人提交的自述；相关情况保持未知。</view><view class="row" wx:if="{{pages>1}}"><button class="secondary" data-step="-1" bindtap="turn" disabled="{{busy||page<=1}}">上一页</button><text>第 {{page}} / {{pages}} 页</text><button class="secondary" data-step="1" bindtap="turn" disabled="{{busy||page>=pages}}">下一页</button></view></view>
