<view class="page"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{busy}}" class="notice">正在读取门店资料…</view><block wx:if="{{clinic}}"><image wx:if="{{clinic.images.length}}" src="{{clinic.images[0].url}}" mode="widthFix" class="profile-cover"/><view class="service-hero"><view class="brand">{{clinic.city}} · {{clinic.district}}</view><view class="title">{{clinic.name}}</view><view class="hero-note">{{clinic.summary}}</view><view class="line">{{clinic.opening.state_label}} · {{clinic.opening.today}}</view></view><view class="card"><view class="section-title">关于本店</view><view class="line">{{clinic.biography}}</view><view class="label">本店服务</view><button wx:for="{{clinic.services}}" wx:key="id" class="secondary" bindtap="service" data-id="{{item.id}}">{{item.name}} · {{item.duration}}分钟 →</button></view><view class="card"><view class="section-title">接诊团队</view><view wx:for="{{clinic.team}}" wx:key="id" class="profile-person" bindtap="doctor" data-id="{{item.id}}" role="button" tabindex="0"><image wx:if="{{item.portrait}}" src="{{item.portrait}}" class="profile-avatar" mode="aspectFill"/><view><view class="label">{{item.name}} · {{item.title}}</view><view class="muted">{{item.summary}}</view><view class="link">了解医师与出诊 →</view></view></view><button bindtap="doctors" class="secondary">查看本店全部医师</button></view><view class="card"><view class="section-title">到诊指引</view><view class="label">门店地址</view><view class="line">{{clinic.address}}</view><view class="muted">{{clinic.entrance}}</view><view class="label">联系电话</view><view wx:if="{{clinic.synthetic}}" class="line">{{clinic.phone}}</view><view wx:else class="line link" bindtap="call">{{clinic.phone}}</view><view class="label">交通与停车</view><view class="line">{{clinic.transport}}</view><view class="muted">{{clinic.parking}}</view><view class="label">无障碍条件</view><view>{{clinic.accessibility=='YES'?'具备':clinic.accessibility=='NO'?'暂不具备':'待核对'}} {{clinic.accessibility_note}}</view><view class="label">每周营业</view><view wx:for="{{clinic.opening.week}}" wx:key="day" class="line">{{item.day}} {{item.hours}}</view><view wx:for="{{clinic.opening.notices}}" wx:key="start" class="notice">{{item.text}}</view><view class="label">费用与医保</view><view class="line">{{clinic.fee_note}}</view><view class="muted">{{clinic.insurance_status}}</view></view></block></view>
