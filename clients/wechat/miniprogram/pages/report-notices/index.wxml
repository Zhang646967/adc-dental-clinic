<view class="page">
  <view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view></view>
  <view class="title">报告与复诊</view>
  <view class="muted">检查报告发布、更正或撤回时在这里提醒。未读为零时也可查看历史提醒。</view>
  <view wx:if="{{unreadCount}}" class="notice">还有 {{unreadCount}} 条未读提醒。打开核对后可逐条标记已读。</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text></view>
  <button wx:if="{{subjectInvalid}}" class="primary" bindtap="recoverSubject" disabled="{{busy}}" loading="{{busy}}">核对账号与就诊人</button>
  <view wx:if="{{busy}}" class="notice">正在读取报告提醒…</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view class="row"><view class="pill">{{item.kindLabel}}</view><view wx:if="{{item.unread}}" class="pill">未读</view></view>
    <view class="section-title">{{item.title}}</view>
    <view class="fact-row"><text>{{item.clinic}}</text><text>{{item.occurredLabel}}</text></view>
    <view wx:if="{{item.withdrawn}}" class="muted">报告已撤回，原就诊记录仍保留；如需继续核对，请联系原门店。</view>
    <view wx:elif="{{item.canOpen}}" class="muted">打开原就诊当前报告的准确版本。</view>
    <view wx:else class="muted">提醒缺少报告版本，请从原就诊核对当前报告。</view>
    <view class="action-row">
      <button wx:if="{{item.canOpen}}" class="primary" data-index="{{index}}" bindtap="open">查看报告</button>
      <button wx:if="{{!item.canOpen}}" class="secondary" data-index="{{index}}" bindtap="contact">联系门店</button>
      <button wx:if="{{item.unread && !readOnly}}" class="secondary" data-index="{{index}}" bindtap="markRead" disabled="{{busy}}">标记已读</button>
    </view>
    <navigator wx:if="{{item.visitUrl}}" class="link" url="{{item.visitUrl}}">查看原就诊</navigator>
  </view>
  <view wx:if="{{!busy && !rows.length && !error && !subjectInvalid}}" class="card empty"><view class="section-title">暂无报告提醒</view><view>报告发布、更正或撤回后，会在这里提醒。</view></view>
  <view wx:if="{{hasPrevious || hasNext}}" class="row"><button disabled="{{!hasPrevious || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}}</view><button disabled="{{!hasNext || busy}}" data-step="1" bindtap="turn">下一页</button></view>
  <button class="secondary" bindtap="retry" disabled="{{busy}}">刷新列表</button>
  <button class="secondary" bindtap="back">返回就诊</button>
  <view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
