<view class="page patient-flow patient-report">
  <view wx:if="{{!selfOnly}}" class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view></view>
  <view class="title">报告与复诊</view>
  <view wx:if="{{unreadCount !== null}}" class="muted">{{unreadCount}} 条未读</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<text wx:if="{{requestId}}" class="support-code" selectable>查询编号 {{requestId}}</text></view>
  <button wx:if="{{subjectInvalid}}" class="primary" bindtap="recoverSubject" disabled="{{busy}}" loading="{{busy}}">核对账号与就诊人</button>
  <view wx:if="{{busy}}" class="notice">正在读取报告提醒…</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view aria-label="{{item.ariaLabel}}">
      <view class="section-title">{{item.heading}}</view>
      <view class="record-head">
        <view wx:if="{{item.showStatus}}" class="pill {{item.tone}}">{{item.statusLabel}}</view>
        <view class="pill {{item.unread?'status-rescheduled':'status-finished'}}">{{item.readLabel}}</view>
      </view>
      <view class="fact-row"><text>{{item.clinic}}</text><text wx:if="{{item.occurredLabel}}">{{item.occurredLabel}}（北京时间）</text></view>
    </view>
    <view class="action-row">
      <button wx:if="{{item.canOpen}}" class="primary" data-index="{{index}}" bindtap="open" aria-label="{{item.heading}}，{{item.actionLabel}}">{{item.actionLabel}}</button>
      <button wx:else class="secondary" data-index="{{index}}" bindtap="contact" aria-label="{{item.heading}}，联系原门店">联系门店</button>
      <button wx:if="{{item.unread && !readOnly}}" class="secondary" data-index="{{index}}" bindtap="markRead" disabled="{{busy}}" aria-label="{{item.heading}}，标记已读">标记已读</button>
    </view>
    <navigator wx:if="{{item.visitUrl}}" class="link" url="{{item.visitUrl}}" aria-label="{{item.heading}}，查看原就诊">查看原就诊</navigator>
  </view>
  <view wx:if="{{!busy && !rows.length && !error && !subjectInvalid}}" class="card empty"><view class="section-title">暂无报告提醒</view><view>报告发布、更正或撤回后，会在这里提醒。</view></view>
  <view wx:if="{{hasPrevious || hasNext}}" class="row"><button disabled="{{!hasPrevious || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}}</view><button disabled="{{!hasNext || busy}}" data-step="1" bindtap="turn">下一页</button></view>
  <button class="secondary" bindtap="retry" disabled="{{busy}}">刷新列表</button>
  <button class="secondary" bindtap="back">{{returnMedical?'返回医疗授权':'返回就诊'}}</button>
  <view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
