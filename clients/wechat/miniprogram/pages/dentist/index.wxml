<view class="page"><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{doctor}}" class="service-hero"><view class="profile-person"><image wx:if="{{doctor.portrait}}" src="{{doctor.portrait}}" class="profile-avatar" mode="aspectFill"/><view><view class="brand">{{doctor.title}} · {{doctor.languages}}</view><view class="title">{{doctor.name}}</view><view class="hero-note">{{doctor.summary}}</view></view></view></view><block wx:if="{{doctor}}"><view class="card"><view class="section-title">了解这位医师</view><view class="line">{{doctor.biography}}</view><view class="profile-tags"><text wx:for="{{doctor.specialty_labels}}" wx:key="*this">{{item}}</text></view><view wx:if="{{doctor.practicing_since}}" class="muted line">从业起始 {{doctor.practicing_since}}</view><view wx:if="{{doctor.education}}" class="line">{{doctor.education}}</view><view class="muted line">{{doctor.credential_status}}</view></view><view wx:for="{{doctor.clinics}}" wx:key="id" class="card"><view class="section-title">{{item.name}}</view><view class="muted">{{item.kind}} · {{item.city}} {{item.district}}</view><view wx:if="{{item.shifts.length}}" class="line">最近出诊 {{item.shifts[0].day}}</view><view wx:else class="notice">近期暂无出诊公示，可查看同店其他医师或登记候补。</view><button wx:for="{{item.services}}" wx:for-item="service" wx:key="id" class="primary" bindtap="book" data-clinic="{{item.id}}" data-service="{{service.id}}" disabled="{{busy}}">{{service.name}} · {{service.duration}}分钟 →</button><button class="secondary" bindtap="clinic" data-id="{{item.id}}">门店与其他接诊医师</button></view><view class="notice">出诊公示不代表已预留号源。登录后按服务、就诊人和资源核对，提交前再次确认。</view></block></view>
