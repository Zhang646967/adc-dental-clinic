<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view>
<view class="title">跨店转诊与披露范围</view><view class="notice">这里核对本人转诊的接收店、指定医师和截止时间。代约关系不授予临床披露权限。</view>
<view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{busy}}" class="notice">正在核对…</view><view wx:if="{{done}}" class="notice">已保存：{{done}}</view>
<view wx:if="{{preview}}" class="card"><view class="section-title">确认终止本次披露</view><view>{{preview.referral.source}} → {{preview.referral.destination}}</view><view>指定接收人：{{preview.referral.receiver}}</view><view class="notice">停止后续查阅，已保留的办理历史与已有预约继续保留。</view>
<checkbox-group bindchange="checked"><label class="check"><checkbox value="yes" checked="{{checked}}"/><text>我是患者本人，明确终止本次转诊披露。</text></label></checkbox-group><button class="danger" disabled="{{!checked||busy}}" loading="{{busy}}" bindtap="confirm">确认终止</button><button class="secondary" disabled="{{busy}}" bindtap="cancel">返回清单</button></view>
<view wx:for="{{rows}}" wx:key="id" class="card"><view class="pill">{{item.status_label}}</view><view class="section-title">{{item.source}} → {{item.destination}}</view><view>接收人：{{item.receiver}}</view><view>查阅截止：{{item.untilLabel}}</view><button wx:if="{{item.can_stop}}" class="secondary" disabled="{{busy||readOnly}}" data-id="{{item.id}}" bindtap="stop">核对并终止披露</button></view>
<view wx:if="{{!busy&&!rows.length&&!error}}" class="card">当前没有本人转诊事项。</view><view class="row"><button disabled="{{busy||page<=1}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{busy||page>=pages}}" data-step="1" bindtap="turn">下一页</button></view><navigator open-type="switchTab" url="/pages/home/index">返回我的预约</navigator></view>
