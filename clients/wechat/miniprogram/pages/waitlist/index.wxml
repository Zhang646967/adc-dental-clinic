<import src="../../templates/patient-results.wxml"/>
<view class="page"><view class="subject-banner"><text>就诊人：{{patientName||'请先选择'}}</text><view>{{patientCapacity}}</view><navigator url="/pages/patients/index" open-type="reLaunch">切换就诊人</navigator></view><view class="page-heading"><view class="title">候补与邀约</view><view class="subtitle">查看等待、确认和成约结果。</view></view><template is="patient-results" data="{{busy, error, requestId, done}}"/>
  <view class="notice">候补登记不等于预约。接受邀约前请核对用途：新增一次就诊，或替换原预约。</view>
  <navigator wx:if="{{!busy && !error && !hasOpen && !readOnly}}" class="link" url="/pages/waitjoin/index">＋ 登记候补偏好</navigator>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view class="pill">{{item.status_label}} · #{{item.id}}</view><view class="section-title">{{item.clinic}} · {{item.service}}</view><view class="line">{{item.startLabel}} 至 {{item.endLabel}}</view><view class="muted">医师偏好：{{item.dentist}}</view>
    <view wx:for="{{item.offers}}" wx:for-item="offer" wx:key="id" class="offer-block"><view class="pill">{{offer.status_label}}</view><view class="time">{{offer.startLabel}}</view><view>至 {{offer.endLabel}} · {{offer.dentist}}</view><view wx:if="{{offer.active}}" class="deadline">请在 {{offer.expiresLabel}} 前确认</view><button class="{{offer.active && !readOnly?'primary':'secondary'}}" data-id="{{offer.id}}" bindtap="offer">{{offer.active && !readOnly?'查看并决定':'查看邀约结果'}}</button><button wx:if="{{offer.visit}}" class="secondary" data-id="{{offer.visit.id}}" bindtap="visit">查看正式预约 · {{offer.visit.status_label}}</button></view>
    <view wx:if="{{!item.offers.length && item.can_withdraw}}" class="empty">前台核对后会提供限时邀约，你可以稍后刷新查看。</view><button wx:if="{{item.can_withdraw && !readOnly}}" class="secondary" data-id="{{item.id}}" bindtap="withdraw" disabled="{{busy}}">退出这条候补</button>
  </view>
  <view wx:if="{{!busy && !rows.length && !error}}" class="card empty"><view class="section-title">还没有候补记录</view><view>暂无合适时段时，登记可接受的日期、时间和医师偏好，交由前台协调。</view></view>
  <view wx:if="{{pages>1}}" class="row"><button disabled="{{page<=1 || busy}}" data-step="-1" bindtap="turn">上一页</button><view>{{page}} / {{pages}}</view><button disabled="{{page>=pages || busy}}" data-step="1" bindtap="turn">下一页</button></view><button class="secondary" disabled="{{busy}}" bindtap="retry">查询候补结果</button><view class="patient-return"><navigator class="link" open-type="switchTab" url="/pages/home/index">返回就诊</navigator></view><navigator class="link" url="/pages/help/index">联系前台协助</navigator>
</view>
