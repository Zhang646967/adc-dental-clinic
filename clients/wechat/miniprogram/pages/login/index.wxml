<view class="page">
  <view class="brand">ADC 口腔</view><view class="title">登录与注册</view>
  <view class="subtitle">微信快捷登录，继续安排你和家人的就诊。</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view class="card">
    <checkbox-group bindchange="authConsent"><label><checkbox value="agree" checked="{{authConfirmed}}" /> 同意使用所选方式登录本人账号。</label></checkbox-group>
    <button class="wechat-login" bindtap="wechatLogin" disabled="{{busy||!auth.wechat_mini||!authConfirmed}}" loading="{{busy}}">微信一键登录</button>
    <view wx:if="{{auth.wechat_mini}}" class="muted">无需用户名、密码或手机号。首次使用将创建ADC账号，病历关联由前台另行核验。</view>
    <view wx:else class="notice">微信登录等待平台配置，当前可使用下方的已开通方式。</view>
    <block wx:if="{{realSmsAvailable}}"><button class="secondary" bindtap="toggleSms" aria-expanded="{{smsMode}}">手机号登录／注册 {{smsMode?'收起':'展开'}}</button>
    <view wx:if="{{smsMode}}">
      <block wx:if="{{auth.sms_enabled}}">
        <label class="label" for="sms-phone">手机号码</label><input id="sms-phone" class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="field" aria-label="手机号码" />
        <block wx:if="{{auth.sms_captcha}}"><button class="secondary" bindtap="captcha" disabled="{{busy}}">平台要求图片验证时点此</button><image wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="widthFix" /><input wx:if="{{captchaImage}}" class="input" value="{{captchaKey}}" data-field="captchaKey" bindinput="field" maxlength="6" aria-label="图片验证码" /></block>
        <button class="secondary" bindtap="sendSms" disabled="{{busy||!authConfirmed}}" loading="{{busy}}">获取验证码</button>
        <view wx:if="{{smsNotice}}" class="notice">{{smsNotice}}</view>
        <label class="label" for="sms-code">验证码</label><input id="sms-code" class="input" type="number" maxlength="6" value="{{smsCode}}" data-field="smsCode" bindinput="field" confirm-type="go" bindconfirm="smsLogin" aria-label="六位验证码" />
        <button class="primary" bindtap="smsLogin" disabled="{{busy||!authConfirmed||!smsChallenge}}" loading="{{busy}}">登录／注册</button>
        <view class="muted">未注册的手机号验证后自动注册。</view>
      </block><view wx:else class="notice">短信服务等待开通，可使用微信或原账号登录。</view>
    </view></block>
    <button class="secondary" bindtap="togglePassword" aria-expanded="{{passwordMode}}">原账号登录／关联 {{passwordMode?'收起':'展开'}}</button>
    <view wx:if="{{passwordMode}}">
      <label class="label" for="username">原患者账号</label><input id="username" class="input" value="{{username}}" maxlength="150" placeholder="请输入患者账号" data-field="username" bindinput="field" aria-label="患者账号" />
      <label class="label" for="password">密码</label><input id="password" class="input" value="{{password}}" password maxlength="128" data-field="password" bindinput="field" confirm-type="go" bindconfirm="login" aria-label="密码" />
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">登录原账号</button>
      <button wx:if="{{auth.wechat_mini}}" class="secondary" bindtap="wechatLogin" disabled="{{busy||!authConfirmed||!username||!password}}">核对原账号并关联微信</button>
      <view class="muted">核对原账号后关联微信；已有其他归属的微信不会自动合并。</view>
    </view>
  </view><view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
