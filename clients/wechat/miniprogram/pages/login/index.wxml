<view class="page">
  <view class="brand">ADC 口腔</view><view class="title">登录与注册</view>
  <view class="subtitle">用手机号码，管理你和家人的就诊安排。</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view class="card">
    <block wx:if="{{auth.sms_enabled}}">
      <view wx:if="{{auth.sms_demo}}" class="notice">试用环境：输入0开头的十一位测试号码（如00000000201），验证码显示在本页，未发送真实短信。</view>
      <label class="label" for="sms-phone">手机号码</label><input id="sms-phone" class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="field" aria-label="手机号码" />
      <label class="label" for="sms-code">验证码</label><input id="sms-code" class="input" type="number" maxlength="6" value="{{smsCode}}" data-field="smsCode" bindinput="field" aria-label="六位验证码" />
      <checkbox-group bindchange="authConsent"><label><checkbox value="agree" checked="{{authConfirmed}}" /> 同意接收验证码，并使用此号码登录或注册本人账号。</label></checkbox-group>
      <button class="secondary" bindtap="sendSms" disabled="{{busy||!authConfirmed}}" loading="{{busy}}">获取验证码</button>
      <view wx:if="{{smsNotice}}" class="notice">{{smsNotice}}</view>
      <button class="primary" bindtap="smsLogin" disabled="{{busy||!authConfirmed||!smsChallenge}}" loading="{{busy}}">登录／注册</button>
      <view class="muted">未注册的手机号验证后自动注册。</view>
    </block><view wx:else class="notice">短信服务尚未配置，请使用已有账号登录。</view>
    <view class="auth-other">其他登录方式</view>
    <checkbox-group wx:if="{{auth.wechat_mini}}" bindchange="authConsent"><label><checkbox value="agree" checked="{{authConfirmed}}" /> 同意使用微信身份登录本人账号。</label></checkbox-group>
    <button class="wechat-login" bindtap="wechatLogin" disabled="{{busy||!auth.wechat_mini||!authConfirmed}}" loading="{{busy}}">微信一键登录</button>
    <view wx:if="{{!auth.wechat_mini}}" class="muted">尚未配置微信授权，请先使用手机号登录。</view>
    <button class="secondary" bindtap="togglePassword" aria-expanded="{{passwordMode}}">账号密码登录 {{passwordMode?'收起':'展开'}}</button>
    <view wx:if="{{passwordMode}}">
      <label class="label" for="username">账号</label><input id="username" class="input" value="{{username}}" maxlength="150" placeholder="请输入患者账号" data-field="username" bindinput="field" aria-label="患者账号" />
      <label class="label" for="password">密码</label><input id="password" class="input" value="{{password}}" password maxlength="128" data-field="password" bindinput="field" confirm-type="go" bindconfirm="login" aria-label="密码" />
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">账号登录</button>
    </view>
  </view><view wx:if="{{environmentLabel}}" class="page-footnote">{{environmentLabel}}</view>
</view>
