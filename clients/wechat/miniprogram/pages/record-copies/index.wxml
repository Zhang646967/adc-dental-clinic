<import src="../../templates/patient-results.wxml"/>
<view class="page"><view class="page-heading"><view class="title">{{isDetail?'病历副本办理':'病历副本申请与领取'}}</view><view class="subtitle">查看申请范围、核验进度和领取结果。</view></view>
<template is="patient-results" data="{{busy, error, requestId, done}}"/><button wx:if="{{error && !uncertain}}" class="secondary" bindtap="load" disabled="{{busy}}">重新读取</button><view wx:if="{{fileError}}" class="notice">{{fileError}}</view><view wx:if="{{readOnly}}" class="notice">当前环境只读，可查看原办理进度。</view>
<view wx:if="{{preview}}" class="card"><view class="section-title">请核对本次办理</view><view class="copy-row" wx:for="{{preview.summary}}" wx:key="index"><view class="copy-label">{{item.label}}</view><text selectable="true">{{item.value}}</text></view><checkbox-group bindchange="consent"><label class="copy-checkbox"><checkbox value="yes" checked="{{confirmed}}" disabled="{{busy || uncertain}}"/><text>已核对患者、用途、准确范围与实际领取账号，明确确认本次办理。</text></label></checkbox-group><view wx:if="{{uncertain}}" class="notice">结果尚未确认。可以从申请清单查询，或重试同一提交。</view><button class="primary" bindtap="confirm" disabled="{{busy || !confirmed}}">{{uncertain?'重试同一提交':'明确确认'}}</button><button class="secondary" bindtap="cancelPreview" disabled="{{busy || readOnly || uncertain}}">返回核对</button></view>
<block wx:elif="{{options}}"><view class="card"><view class="section-title">申请本人副本</view><view>监护或书面受托复制请联系门店核验原件并登记到领取账号。</view><view class="copy-label">办理门店</view><picker class="picker" range="{{options.clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="clinic">{{options.clinics[clinicIndex].name || '暂无已结束接诊'}}</picker>
<view class="copy-label">需要复制的就诊</view><checkbox-group bindchange="visits"><label wx:for="{{options.visits}}" wx:key="id" class="copy-checkbox"><checkbox value="{{item.id}}" checked="{{item.checked}}"/><text>{{item.label}}</text></label></checkbox-group><view wx:if="{{!options.visits.length}}" class="notice">当前门店尚无可申请的已结束接诊，可联系门店核对。</view>
<view class="copy-label">资料类别</view><checkbox-group bindchange="sections"><label wx:for="{{options.sections}}" wx:key="id" class="copy-checkbox"><checkbox value="{{item.id}}" checked="{{item.checked}}"/><text>{{item.label}}</text></label></checkbox-group>
<view class="copy-label">固定版本</view><picker class="picker" range="{{options.packages}}" range-key="label" value="{{packageIndex}}" bindchange="package">{{options.packages[packageIndex].label}}</picker><view>指定历史版本时，请单独选择该次就诊。</view><view class="copy-label">复制用途</view><textarea data-field="purpose" value="{{purpose}}" bindinput="input" maxlength="500" placeholder="例如：复诊就医、个人留存、费用核对"/><button class="primary" data-action="SUBMIT" bindtap="prepare" disabled="{{busy || readOnly}}">预览申请范围 →</button></view></block>
<block wx:elif="{{detail}}"><view class="card"><view class="section-title">{{detail.patient}} · 申请 {{detail.id}}</view><view class="pill">{{detail.status_label}}</view><view>{{detail.clinic}} · {{detail.kind}}</view><view>领取人：{{detail.recipient}}</view><view>用途：{{detail.purpose}}</view><view class="notice" wx:if="{{detail.message}}">{{detail.message}}</view><view wx:if="{{detail.pickupLabel}}">领取期限：{{detail.pickupLabel}}（北京时间）</view><view wx:for="{{detail.items}}" wx:key="visit" class="copy-scope"><view>{{item.visit_no}} · {{item.package_number?'固定第'+item.package_number+'包':'固定材料待就绪'}}</view><view>{{item.kind}}</view><view wx:for="{{item.sections}}" wx:for-item="section" wx:key="*this">{{section}}</view></view>
<button wx:if="{{detail.can_pickup}}" class="primary" data-action="CLAIM" bindtap="prepare" disabled="{{busy || readOnly}}">核对并领取电子副本 →</button><view wx:if="{{detail.can_pickup}}">服务端文件响应不证明已经阅读。需要正式证明，请联系门店办理。</view><block wx:if="{{detail.can_resubmit || detail.can_withdraw}}"><view class="copy-label">补充说明／撤回原因</view><textarea data-field="message" value="{{message}}" bindinput="input" maxlength="500"/><button wx:if="{{detail.can_resubmit}}" data-action="RESUBMIT" bindtap="prepare" disabled="{{busy || readOnly}}">预览补充后提交</button><button wx:if="{{detail.can_withdraw}}" data-action="WITHDRAW" bindtap="prepare" disabled="{{busy || readOnly}}">预览撤回申请</button></block></view><view class="card"><view class="section-title">办理历史</view><view class="copy-row" wx:for="{{detail.history}}" wx:key="index">{{item.atLabel}} · {{item.action}}</view></view></block>
<block wx:elif="{{!isDetail && !busy && !error}}"><view class="card"><navigator wx:if="{{!readOnly}}" class="primary link" url="/pages/record-copies/index?new=1">申请本人病历副本 →</navigator><view>监护／书面受托复制由门店另行核验，本申请不会开放其他病历或账单。</view></view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="section-title">{{item.patient}} · 申请 {{item.id}}</view><view class="pill">{{item.status_label}}</view><view class="line">{{item.clinic}}</view><navigator class="link" url="/pages/record-copies/index?id={{item.id}}">查看范围与进度 →</navigator></view><view wx:if="{{!rows.length && !busy}}" class="notice">尚无病历副本申请。</view><view wx:if="{{pagination.pages > 1}}" class="copy-controls"><button bindtap="pageChange" data-direction="previous" disabled="{{!pagination.previous || busy}}">上一页</button><text>{{pagination.page}} / {{pagination.pages}}</text><button bindtap="pageChange" data-direction="next" disabled="{{!pagination.next || busy}}">下一页</button></view></block><view class="patient-return"><button class="secondary" bindtap="back" disabled="{{busy}}">{{isDetail?'查看副本申请清单':'返回我的'}}</button></view></view>
