.copy-scope{margin:18rpx 0;padding:18rpx;background:#f1f6f3;border-radius:12rpx}.copy-row{margin:18rpx 0;overflow-wrap:anywhere}.copy-label{font-weight:600;color:#164e45}.copy-controls{display:flex;gap:16rpx;flex-wrap:wrap}.copy-controls button{flex:1;min-width:160rpx}.copy-checkbox{display:flex;align-items:flex-start;gap:8rpx;padding:16rpx 0}textarea{width:100%;min-height:150rpx;box-sizing:border-box}picker{padding:20rpx;border:1rpx solid #b4c8c0;border-radius:10rpx;margin:14rpx 0}button{white-space:normal}.copy-footer{padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}
