<view class="page"><view wx:if="{{guest}}" class="card"><view class="section-title">欢迎使用 ADC 口腔</view><view class="line">可以先浏览门店和医师；登录后管理本人账号、就诊人与预约。</view><button class="primary" bindtap="login">登录／注册</button></view><block wx:else><view class="brand">ADC DENTAL CARE · 患者账号</view><view class="title">把就诊资料准备好</view><view class="subtitle">登录、联络与本人档案分别核对。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
<view wx:if="{{readOnly}}" class="notice">当前环境只读；可查看原办理结果。</view><view wx:if="{{profile}}"><view class="card"><view class="section-title">我的ADC账号</view><text selectable="true">{{profile.account_name}}</text><view wx:if="{{profile.enrollment_required}}">尚需前台核验本人档案；现在仍可浏览门店。</view><button wx:else class="primary" bindtap="activate" disabled="{{busy}}">进入已授权的患者服务 →</button><navigator wx:if="{{profile.can_request_enrollment && !readOnly}}" class="link" url="/pages/enrollment/index">{{profile.self_binding_needs_review?'申请复核原本人关联':'申请新建或关联本人档案'}} →</navigator><view wx:if="{{profile.self_binding_needs_review}}" class="notice">原本人关联需要复核，请联系门店按原账号恢复流程办理，不能另建档案绕过停用。</view></view>
<view class="section-title">我的办理记录</view><view wx:for="{{profile.cases}}" wx:key="id" class="card"><view class="time">{{item.clinic_name}}</view><view>{{item.kind_label}} · {{item.state_label}}</view><view class="muted">{{item.createdLabel}}</view><view wx:if="{{item.patient_message}}" class="notice">{{item.patient_message}}</view><button wx:if="{{item.can_edit}}" data-id="{{item.id}}" bindtap="edit" disabled="{{busy||readOnly}}">补充资料</button><button wx:if="{{item.can_withdraw}}" data-id="{{item.id}}" data-revision="{{item.revision}}" bindtap="withdraw" disabled="{{busy||readOnly}}">撤回本次申请</button></view><view wx:if="{{!profile.cases.length}}" class="muted">暂无办理记录。</view>
<view class="card"><view class="section-title">账号联络号码</view><view wx:if="{{profile.phone}}">{{profile.phone.number}} · {{profile.phone.source_label}}</view><view wx:else>尚未绑定账号联络号码。</view><block wx:if="{{profile.local_identity_enabled}}"><label class="label" for="phone-code">本地手机授权码</label><input id="phone-code" class="input" password value="{{phoneCode}}" data-field="phoneCode" bindinput="field" maxlength="160" /><button bindtap="phone" disabled="{{busy||readOnly||!phoneCode}}">核对并绑定合成号码</button><view class="muted">合成凭证不验证真实手机，不改写患者联络资料。</view></block><button wx:if="{{auth.wechat_phone}}" open-type="getPhoneNumber" bindgetphonenumber="wechatPhone" disabled="{{busy||readOnly}}">同意微信授权并一键绑定手机号</button><block wx:if="{{auth.sms_enabled}}"><view wx:if="{{auth.sms_demo}}" class="notice">课程测试使用0开头的十一位合成号码，不发送真实短信。</view><label class="label" for="sms-bind-phone">手机号码</label><input id="sms-bind-phone" class="input" type="number" maxlength="11" value="{{smsPhone}}" data-field="smsPhone" bindinput="field" /><block wx:if="{{auth.sms_captcha}}"><button class="secondary" bindtap="captcha" disabled="{{busy}}">平台要求图片验证时点此</button><image wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="widthFix" /><input wx:if="{{captchaImage}}" class="input" value="{{captchaKey}}" data-field="captchaKey" bindinput="field" maxlength="6" aria-label="图片验证码" /></block><button bindtap="sendPhoneSms" disabled="{{busy||readOnly}}">发送绑定验证码</button><view wx:if="{{smsNotice}}" class="notice">{{smsNotice}}</view><label class="label" for="sms-bind-code">六位验证码</label><input id="sms-bind-code" class="input" type="number" maxlength="6" value="{{smsCode}}" data-field="smsCode" bindinput="field" confirm-type="go" bindconfirm="bindPhoneSms" /><button bindtap="bindPhoneSms" disabled="{{busy||readOnly||!smsChallenge}}">核验并绑定手机号</button></block></view>
<view wx:if="{{profile.local_identity_enabled}}" class="card"><view class="section-title">密码与账号恢复</view><view>{{profile.password_ready?'已有可用密码，可在网站登录。':'设置密码后，可在解绑后登录同一账号。'}}</view><label class="label" for="login-code">当前绑定身份的新本地授权码</label><input id="login-code" class="input" password value="{{loginCode}}" data-field="loginCode" bindinput="field" maxlength="160" /><label class="label" for="new-password">设置登录密码</label><input id="new-password" class="input" password value="{{newPassword}}" data-field="newPassword" bindinput="field" maxlength="128" /><label class="label" for="repeat-password">再次输入密码</label><input id="repeat-password" class="input" password value="{{repeatPassword}}" data-field="repeatPassword" bindinput="field" maxlength="128" /><button bindtap="password" disabled="{{busy||readOnly}}">核对身份并设置密码</button></view>
<view class="card"><view class="section-title">快捷登录绑定</view><button wx:if="{{auth.wechat_mini}}" bindtap="bindWechat" disabled="{{busy||readOnly}}">绑定当前微信登录</button><view class="muted">快捷登录与就诊档案分开维护，解绑保留账号及原业务。</view><label wx:if="{{profile.identities.length}}" class="label" for="unlink-password">解绑时核对账号密码</label><input wx:if="{{profile.identities.length}}" id="unlink-password" class="input" password value="{{unlinkPassword}}" data-field="unlinkPassword" bindinput="field" maxlength="128" /><button wx:for="{{profile.identities}}" wx:key="id" data-id="{{item.id}}" data-revision="{{item.revision}}" bindtap="unlink" disabled="{{busy||readOnly}}">解除{{item.provider_label}} {{item.id}}的绑定</button><view wx:if="{{!profile.identities.length}}">当前没有快捷登录绑定。</view></view></view>
<button bindtap="load" disabled="{{busy}}">刷新办理状态</button><navigator open-type="switchTab" class="link" url="/pages/discovery/index">继续浏览门店</navigator><button bindtap="logout">退出账号</button></block></view>
