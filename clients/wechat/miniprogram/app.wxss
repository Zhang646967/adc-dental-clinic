.patient-flow.text-scale-xlarge .prose,.patient-flow.text-scale-xlarge .line,.patient-flow.text-scale-xlarge .label{font-size:50rpx}
.patient-flow.text-scale-xlarge .muted,.patient-flow.text-scale-xlarge .small,.patient-flow.text-scale-xlarge .page-footnote{font-size:44rpx}
.patient-flow.text-scale-xlarge .time{font-size:60rpx}
