page{background:#f4f7f9;color:#18333b;font-size:34rpx;line-height:1.6;font-family:system-ui,sans-serif}
.page{padding:32rpx 28rpx 70rpx}.brand{font-size:26rpx;letter-spacing:3rpx;color:#34796c}.title{font-size:48rpx;font-weight:700;line-height:1.3;margin:12rpx 0 20rpx}.subtitle,.muted{color:#536c75;font-size:30rpx}.card{background:#fff;border:2rpx solid #dde8eb;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 6rpx 18rpx #18333b08}.label{display:block;font-weight:600;margin:24rpx 0 10rpx}.input,.picker,textarea{box-sizing:border-box;width:100%;background:#fff;border:2rpx solid #a4b7bc;border-radius:12rpx;padding:20rpx;color:#18333b;min-height:92rpx;font-size:34rpx}textarea{height:190rpx}.row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.row>*{flex:1;min-width:150rpx}.actions{margin-top:28rpx}button{font-size:34rpx;margin:18rpx 0;min-height:96rpx;border-radius:14rpx;font-weight:600;white-space:normal;line-height:1.5;padding:22rpx 18rpx}button.primary{background:#0c6d60;color:#fff}button.secondary{background:#e4f1ee;color:#145e53;border:2rpx solid #b8d5ce}button.danger{background:#fff2ef;color:#9e3527;border:2rpx solid #e6b9b1}button[disabled]{opacity:.5}.error{padding:24rpx;background:#fff0ed;color:#8e291b;border-left:8rpx solid #d86549;border-radius:10rpx;margin:24rpx 0;word-break:break-all}.notice{padding:22rpx;background:#eaf3fa;color:#24546e;border-radius:12rpx;margin:22rpx 0}.pill{color:#145e53;background:#e4f1ee;padding:5rpx 16rpx;border-radius:10rpx;font-size:28rpx;display:inline-block}.line{margin:10rpx 0;word-break:break-word}.time{font-size:38rpx;font-weight:650}.divider{height:2rpx;background:#e3ebee;margin:22rpx 0}.empty{padding:32rpx 6rpx;color:#536c75}.check{display:flex;gap:12rpx;align-items:flex-start;margin:26rpx 0;font-size:32rpx}checkbox{flex:none}.small{font-size:28rpx}navigator.link{color:#095c67;text-decoration:underline;padding:16rpx 0}.tabs button{font-size:30rpx;padding:18rpx 10rpx;min-height:80rpx}.tabs .selected{background:#145e53;color:#fff}.right{float:right}.account{margin:22rpx 0}
