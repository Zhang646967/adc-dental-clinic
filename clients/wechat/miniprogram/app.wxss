.patient-flow.text-scale-xlarge .subject-banner navigator,.patient-flow.text-scale-xlarge .subject-banner button{font-size:44rpx}
.patient-flow.text-scale-xlarge .identity-name{font-size:50rpx}
.patient-flow.text-scale-xlarge .identity-meta,.patient-flow.text-scale-xlarge .preview-state{font-size:44rpx}
.patient-flow.text-scale-xlarge .visit-source,.patient-flow.text-scale-xlarge .checkout-id,.patient-flow.text-scale-xlarge .primary-visit-no{font-size:46rpx}
.patient-flow.text-scale-xlarge .pill{font-size:46rpx}
.patient-flow.text-scale-xlarge button.disclosure{font-size:44rpx}
.patient-flow.text-scale-xlarge .shortcut{font-size:47rpx}
.patient-flow.text-scale-xlarge .fee{font-size:59rpx}
