.patient-flow.text-scale-compact .prose,.patient-flow.text-scale-compact .line,.patient-flow.text-scale-compact .label{font-size:28rpx}
.patient-flow.text-scale-compact .muted,.patient-flow.text-scale-compact .small,.patient-flow.text-scale-compact .page-footnote{font-size:24rpx}
.patient-flow.text-scale-compact .time{font-size:33rpx}
.patient-flow.text-scale-compact .tz{font-size:24rpx}
.patient-flow.text-scale-compact button{font-size:28rpx}
.patient-flow.text-scale-compact button.compact{font-size:24rpx}
.patient-flow.text-scale-compact .check{font-size:28rpx}
.patient-flow.text-scale-compact .subject-banner{font-size:24rpx}
.patient-flow.text-scale-compact .subject-banner navigator,.patient-flow.text-scale-compact .subject-banner button{font-size:24rpx}
.patient-flow.text-scale-compact .identity-name{font-size:28rpx}
.patient-flow.text-scale-compact .identity-meta,.patient-flow.text-scale-compact .preview-state{font-size:24rpx}
.patient-flow.text-scale-compact .visit-source,.patient-flow.text-scale-compact .checkout-id,.patient-flow.text-scale-compact .primary-visit-no{font-size:25rpx}
.patient-flow.text-scale-compact .pill{font-size:25rpx}
.patient-flow.text-scale-compact button.disclosure{font-size:24rpx}
.patient-flow.text-scale-compact .shortcut{font-size:26rpx}
.patient-flow.text-scale-compact .fee{font-size:32rpx}
.patient-flow.text-scale-compact .hero-facts,.patient-flow.text-scale-compact .hero-fee{font-size:24rpx}
.patient-flow.text-scale-compact .picker,.patient-flow.text-scale-compact textarea,.patient-flow.text-scale-compact .input{font-size:31rpx}

.patient-flow.text-scale-large{font-size:37rpx}
.patient-flow.text-scale-large .title,.patient-flow.text-scale-large .service-hero .title{font-size:56rpx}
.patient-flow.text-scale-large .section-title{font-size:42rpx}
.patient-flow.text-scale-large .section-label{font-size:33rpx}
.patient-flow.text-scale-large .prose,.patient-flow.text-scale-large .line,.patient-flow.text-scale-large .label{font-size:37rpx}
.patient-flow.text-scale-large .muted,.patient-flow.text-scale-large .small,.patient-flow.text-scale-large .page-footnote{font-size:32rpx}
.patient-flow.text-scale-large .time{font-size:44rpx}
.patient-flow.text-scale-large .tz{font-size:32rpx}
.patient-flow.text-scale-large button{font-size:37rpx}
.patient-flow.text-scale-large button.compact{font-size:32rpx}
.patient-flow.text-scale-large .check{font-size:37rpx}
.patient-flow.text-scale-large .subject-banner{font-size:32rpx}
.patient-flow.text-scale-large .subject-banner navigator,.patient-flow.text-scale-large .subject-banner button{font-size:32rpx}
.patient-flow.text-scale-large .identity-name{font-size:37rpx}
.patient-flow.text-scale-large .identity-meta,.patient-flow.text-scale-large .preview-state{font-size:32rpx}
.patient-flow.text-scale-large .visit-source,.patient-flow.text-scale-large .checkout-id,.patient-flow.text-scale-large .primary-visit-no{font-size:33rpx}
.patient-flow.text-scale-large .pill{font-size:33rpx}
.patient-flow.text-scale-large button.disclosure{font-size:32rpx}
.patient-flow.text-scale-large .shortcut{font-size:34rpx}
.patient-flow.text-scale-large .fee{font-size:43rpx}
.patient-flow.text-scale-large .hero-facts,.patient-flow.text-scale-large .hero-fee{font-size:32rpx}
.patient-flow.text-scale-large .picker,.patient-flow.text-scale-large textarea,.patient-flow.text-scale-large .input{font-size:40rpx}

.patient-flow.text-scale-xlarge{font-size:50rpx}
.patient-flow.text-scale-xlarge .title,.patient-flow.text-scale-xlarge .service-hero .title{font-size:76rpx}
