page{background:#f3f6f5;color:#18333b;font-size:34rpx;line-height:1.6;font-family:system-ui,sans-serif}
.prose{white-space:pre-wrap;overflow-wrap:break-word}.fee{font-size:36rpx;font-weight:650;color:#145e53;margin:16rpx 0}
.page{padding:32rpx 28rpx 70rpx}.brand{font-size:26rpx;letter-spacing:3rpx;color:#34796c}.title{font-size:48rpx;font-weight:700;line-height:1.3;margin:12rpx 0 20rpx}.subtitle,.muted{color:#536c75;font-size:30rpx}.card{background:#fff;border:2rpx solid #dde8eb;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 6rpx 18rpx #18333b08}.label{display:block;font-weight:600;margin:24rpx 0 10rpx}.input,.picker,textarea{box-sizing:border-box;width:100%;background:#fff;border:2rpx solid #a4b7bc;border-radius:12rpx;padding:20rpx;color:#18333b;min-height:92rpx;font-size:34rpx}textarea{height:190rpx}.row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.row button,.row view{flex:1;min-width:150rpx}.actions{margin-top:28rpx}button{font-size:34rpx;margin:18rpx 0;min-height:96rpx;border-radius:14rpx;font-weight:600;white-space:normal;line-height:1.5;padding:22rpx 18rpx}button.primary{background:#0c6d60;color:#fff}button.secondary{background:#e4f1ee;color:#145e53;border:2rpx solid #b8d5ce}button.danger{background:#fff2ef;color:#9e3527;border:2rpx solid #e6b9b1}button[disabled]{opacity:.5}.error{padding:24rpx;background:#fff0ed;color:#8e291b;border-left:8rpx solid #d86549;border-radius:10rpx;margin:24rpx 0;word-break:break-all}.notice{padding:22rpx;background:#eaf3fa;color:#24546e;border-radius:12rpx;margin:22rpx 0}.pill{color:#145e53;background:#e4f1ee;padding:5rpx 16rpx;border-radius:10rpx;font-size:28rpx;display:inline-block}.line{margin:10rpx 0;word-break:break-word}.time{font-size:38rpx;font-weight:650}.divider{height:2rpx;background:#e3ebee;margin:22rpx 0}.empty{padding:32rpx 6rpx;color:#536c75}.check{display:flex;gap:12rpx;align-items:flex-start;margin:26rpx 0;font-size:32rpx}checkbox{flex:none}.small{font-size:28rpx}navigator.link{color:#095c67;text-decoration:underline;padding:16rpx 0}.tabs button{font-size:30rpx;padding:18rpx 10rpx;min-height:80rpx}.tabs .selected{background:#145e53;color:#fff}.right{float:right}.account{margin:22rpx 0}

.service-hero{background:linear-gradient(130deg,#123f36,#226654);color:#fff;border-radius:28rpx;padding:38rpx 30rpx;margin:0 0 28rpx}.service-hero .brand{color:#cce6d8;font-size:25rpx;letter-spacing:2rpx}.service-hero .title{font-size:48rpx;margin:24rpx 0}.hero-note{color:#e1eee6;font-size:30rpx}.hero-button{background:#f4ecd7;color:#183c31;margin-top:32rpx}.quick-grid{display:flex;gap:20rpx;margin:28rpx 0}.quick-item{flex:1;min-width:0;background:#fff;border:2rpx solid #d4e2da;border-radius:20rpx;padding:26rpx 22rpx;color:#265747}.stat{font-size:44rpx;font-weight:700;line-height:1.3;margin-bottom:12rpx}.section-heading{display:flex;gap:20rpx;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:38rpx 0 18rpx}.section-title{font-size:38rpx;font-weight:700;margin:14rpx 0}.section-label{font-size:28rpx;font-weight:600;color:#4f7062}.attention{background:#fff5df;border:2rpx solid #d9bc82;border-left:8rpx solid #9c6a10;border-radius:18rpx;padding:26rpx;margin:26rpx 0}.attention .label{margin-top:0}.offer-block{background:#f2f7f4;border-radius:16rpx;padding:24rpx;margin-top:24rpx}.deadline{color:#7b4c08;background:#fff5df;padding:16rpx;margin:18rpx 0;border-radius:10rpx}.time-picker{margin-top:14rpx}.page-footnote{font-size:26rpx;color:#51685e;text-align:center;margin-top:32rpx}.next-card{border-left:8rpx solid #487b62}

.subject-banner{background:#e8f3ef;color:#173d35;border-radius:16rpx;padding:22rpx;margin:0 0 24rpx;line-height:1.6}.subject-banner navigator{color:#176454;text-decoration:underline;padding:12rpx 0}.subject-banner text{font-weight:600}

.clinic-card-top{display:flex;justify-content:space-between;gap:16rpx;flex-wrap:wrap}.hours-grid{font-size:26rpx;color:#486155;margin-top:16rpx}.hours-grid view{margin-bottom:6rpx}.action-row{display:flex;gap:16rpx;flex-wrap:wrap}.action-row button{flex:1;min-width:180rpx}

.auth-other{margin:32rpx 0 12rpx;text-align:center;font-size:24rpx;color:#66786f}.wechat-login{background:#eff8f1;color:#087b40;border:1rpx solid #c7e2ce}.wechat-login[disabled]{background:#f2f6f3;color:#61776a}

/* P1.5: one compact patient layout across discovery and private tasks. */
page{background:#f7f9f5;color:#193d35;font-size:30rpx;line-height:1.6}.page{padding:28rpx 26rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow-wrap:anywhere}.card{border:1rpx solid #dbe5dc;border-radius:22rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 4rpx 18rpx rgba(23,63,47,.025)}.page-heading{padding:12rpx 4rpx 26rpx}.title{font-size:44rpx;line-height:1.35;margin:18rpx 0}.section-title{font-size:34rpx;line-height:1.45}.service-hero{padding:32rpx 28rpx;border-radius:24rpx}.service-hero .title{font-size:44rpx}.hero-note{font-size:29rpx}.hero-actions,.filter-actions{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.hero-actions button{flex:1;font-size:28rpx;margin-top:24rpx}.filter-grid{display:flex;gap:18rpx}.filter-grid>view{flex:1;min-width:0}.picker{min-width:0;white-space:normal}.filter-actions{justify-content:space-between;margin:18rpx 0}.compact{font-size:27rpx;min-height:76rpx;padding:10rpx 18rpx;margin:0}.filter-actions label{display:flex;align-items:center;gap:8rpx}.branch-cover{width:100%;height:240rpx;border-radius:16rpx;margin-bottom:18rpx}.profile-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:18rpx 0}.profile-tags text{background:#eef3eb;color:#3f6355;font-size:25rpx;padding:7rpx 13rpx;border-radius:10rpx}.task-links navigator{padding:22rpx 0;border-bottom:1rpx solid #e3ebe2;color:#176455}.fact-row{display:flex;justify-content:space-between;gap:18rpx;flex-wrap:wrap;padding:16rpx 0}.invoice-line{padding:18rpx 0;border-bottom:1rpx solid #e2e9df}.invoice-total{display:flex;justify-content:space-between;gap:18rpx;font-weight:700;padding-top:24rpx}.invoice-total text{font-size:38rpx;color:#14685d}.gallery{height:360rpx;margin-bottom:22rpx}.gallery image{width:100%;height:100%;border-radius:20rpx}button{min-width:0;white-space:normal}.error button{margin-top:18rpx}.page-footnote{font-size:24rpx}

.service-hero{padding:26rpx}.service-hero .title{font-size:40rpx;margin:16rpx 0}.hero-actions button{min-height:76rpx;margin-top:18rpx;font-size:27rpx}.branch-cover{height:200rpx;margin:14rpx 0}.filter-actions{gap:10rpx}.filter-actions .compact{padding:8rpx 14rpx}
