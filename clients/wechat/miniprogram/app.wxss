.clinic-card-top{display:flex;justify-content:space-between;gap:16rpx;flex-wrap:wrap}.hours-grid{font-size:26rpx;color:#486155;margin-top:16rpx}.hours-grid view{margin-bottom:6rpx}.action-row{display:flex;gap:16rpx;flex-wrap:wrap}.action-row button{flex:1;min-width:180rpx}

.auth-other{margin:32rpx 0 12rpx;text-align:center;font-size:24rpx;color:#66786f}.wechat-login{background:#eff8f1;color:#087b40;border:1rpx solid #c7e2ce}.wechat-login[disabled]{background:#f2f6f3;color:#61776a}

/* P1.5: one compact patient layout across discovery and private tasks. */
page{background:#f7f9f5;color:#193d35;font-size:30rpx;line-height:1.6}.page{padding:28rpx 26rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow-wrap:anywhere}.card{border:1rpx solid #dbe5dc;border-radius:22rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 4rpx 18rpx rgba(23,63,47,.025)}.page-heading{padding:12rpx 4rpx 26rpx}.title{font-size:44rpx;line-height:1.35;margin:18rpx 0}.section-title{font-size:34rpx;line-height:1.45}.service-hero{padding:32rpx 28rpx;border-radius:24rpx}.service-hero .title{font-size:44rpx}.hero-note{font-size:29rpx}.hero-actions,.filter-actions{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.hero-actions button{flex:1;font-size:28rpx;margin-top:24rpx}.filter-grid{display:flex;gap:18rpx}.filter-grid>view{flex:1;min-width:0}.picker{min-width:0;white-space:normal}.filter-actions{justify-content:space-between;margin:18rpx 0}.compact{font-size:27rpx;min-height:76rpx;padding:10rpx 18rpx;margin:0}.filter-actions label{display:flex;align-items:center;gap:8rpx}.branch-cover{width:100%;height:240rpx;border-radius:16rpx;margin-bottom:18rpx}.profile-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:18rpx 0}.profile-tags text{background:#eef3eb;color:#3f6355;font-size:25rpx;padding:7rpx 13rpx;border-radius:10rpx}.task-links navigator{padding:22rpx 0;border-bottom:1rpx solid #e3ebe2;color:#176455}.fact-row{display:flex;justify-content:space-between;gap:18rpx;flex-wrap:wrap;padding:16rpx 0}.invoice-line{padding:18rpx 0;border-bottom:1rpx solid #e2e9df}.invoice-total{display:flex;justify-content:space-between;gap:18rpx;font-weight:700;padding-top:24rpx}.invoice-total text{font-size:38rpx;color:#14685d}.gallery{height:360rpx;margin-bottom:22rpx}.gallery image{width:100%;height:100%;border-radius:20rpx}button{min-width:0;white-space:normal}.error button{margin-top:18rpx}.page-footnote{font-size:24rpx}

.service-hero{padding:26rpx}.service-hero .title{font-size:40rpx;margin:16rpx 0}.hero-actions button{min-height:76rpx;margin-top:18rpx;font-size:27rpx}.branch-cover{height:200rpx;margin:14rpx 0}.filter-actions{gap:10rpx}.filter-actions .compact{padding:8rpx 14rpx}

/* Patient entry hierarchy shared by the booking and account flows. */
.steps{color:#315e50;font-weight:600;margin:0 0 24rpx;line-height:1.55}
.entry-links{display:flex;flex-wrap:wrap;gap:16rpx}
.entry-links button{flex:1;min-width:7em;background:transparent;color:#fff;border:1rpx solid #91b8a6;margin:0}
.support-code{display:block;margin-top:12rpx;color:#664139;font-size:.9em;overflow-wrap:anywhere}
.patient-section{margin-top:32rpx}
.patient-section navigator{display:block;min-height:44px;box-sizing:border-box}
.result-success{background:#e7f2e9;color:#245c40}
.patient-return{margin-top:36rpx;padding-top:16rpx;border-top:1rpx solid #dbe5dc}
.patient-return navigator{display:block}

/* 18542: one hierarchy across discovery, service, booking, confirm and visit.
   At 390 logical px: title 24, section 18, body 16, auxiliary 14; tap areas 44+. */
.patient-flow{font-size:31rpx;line-height:1.65}
.patient-flow .title{font-size:47rpx;line-height:1.35;margin:14rpx 0 20rpx}
.patient-flow .section-title{font-size:35rpx;line-height:1.45}
.patient-flow .section-label{font-size:28rpx}
.patient-flow .prose,.patient-flow .line,.patient-flow .label{font-size:31rpx}
.patient-flow .muted,.patient-flow .small,.patient-flow .page-footnote{font-size:27rpx}
.patient-flow .time{font-size:37rpx}
.patient-flow .tz{font-size:27rpx;color:#536c75;font-weight:400}
.patient-flow button{min-height:88rpx;font-size:31rpx}
.patient-flow button.compact{min-height:88rpx;font-size:27rpx;padding:10rpx 20rpx}
.patient-flow .check{min-height:88rpx;align-items:center;font-size:31rpx;gap:16rpx}
.patient-flow .subject-banner{display:flex;align-items:center;gap:8rpx 16rpx;flex-wrap:wrap;padding:12rpx 18rpx;font-size:27rpx;margin-bottom:20rpx}
.patient-flow .subject-banner text{font-weight:600}
.patient-flow .subject-banner navigator,.patient-flow .subject-banner button{min-height:88rpx;line-height:88rpx;padding:0 10rpx;margin:0;width:auto;flex:none;background:transparent;color:#176454;text-decoration:underline;font-size:27rpx;font-weight:600}
.patient-flow .identity-bar{display:flex;align-items:center;justify-content:space-between;gap:12rpx;flex-wrap:wrap;background:#e8f3ef;color:#173d35;border-radius:16rpx;padding:10rpx 18rpx;margin-bottom:18rpx;font-size:27rpx}
.patient-flow .identity-main{display:flex;align-items:baseline;gap:10rpx;flex-wrap:wrap;min-width:0;flex:1}
.patient-flow .identity-name{font-weight:700;font-size:31rpx}
.patient-flow .identity-meta{color:#536c75;font-size:27rpx}
.patient-flow .identity-actions{display:flex;gap:8rpx;flex-wrap:wrap}
.patient-flow .identity-actions button{margin:0;width:auto;flex:none;padding:0 20rpx}
.patient-flow .preview-state{display:inline-block;background:#e4f1ee;color:#145e53;border-radius:12rpx;padding:10rpx 18rpx;font-size:27rpx;font-weight:600;margin:0 0 10rpx}
.patient-flow .service-hero .title{font-size:47rpx;margin:14rpx 0}
.patient-flow .hero-facts{display:flex;flex-wrap:wrap;gap:8rpx 18rpx;font-size:27rpx;color:#dff0e7;margin:14rpx 0}
.patient-flow .hero-fee{font-size:27rpx;color:#d8e9df;line-height:1.6;margin-top:14rpx}
.patient-flow .hero-button{min-height:88rpx}
.patient-flow .result-pending .section-title{margin-top:8rpx}

/* Keep a long source visit number compact and break it at any character. */
.patient-flow .visit-source,.patient-flow .checkout-id{font-size:28rpx;word-break:break-all}

/* Long invoice numbers stay readable without breaking the layout. */
.invoice-id{font-size:30rpx;line-height:1.4;word-break:break-all}

/* The instruction opened from the primary action stays visibly selected. */
.patient-flow .followup-selected{border-left:8rpx solid #0c6d60;background:#e8f3ef}

/* The next-visit number stays on one line without competing with the action. */
.primary-visit-no{font-size:28rpx;word-break:break-all}

/* 18550: one disclosure per record, status tones and patient short names.
   Status stays readable in the pill; the four kinds only change its tone. */
.patient-flow .record-head{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;margin:0 0 10rpx}
.patient-flow .status-upcoming{background:#e4f1ee;color:#145e53}
.patient-flow .status-arrived{background:#e6f0fa;color:#1d4f7c}
.patient-flow .status-finished,.patient-flow .status-missed,.patient-flow .status-unknown{background:#edf0ee;color:#40564d}
.patient-flow .status-rescheduled{background:#fff4dd;color:#7b4c08}
.patient-flow .status-cancelled{background:#fbece8;color:#8e291b}
.patient-flow button.disclosure{background:transparent;color:#0b6a5e;text-align:left;padding:10rpx 0;margin:6rpx 0 0;min-height:88rpx;font-size:27rpx;font-weight:600;line-height:1.45}
.patient-flow button.disclosure::after{border:0}
.patient-flow .detail-panel{background:#f6faf7;border-left:8rpx solid #cfe3d8;border-radius:12rpx;padding:6rpx 20rpx 16rpx;margin:6rpx 0 14rpx}
.patient-flow .detail-panel .fact-row{padding:10rpx 0}
.patient-flow .detail-panel .invoice-line:last-child{border-bottom:0}
.patient-flow .shortcut-grid{display:flex;flex-wrap:wrap;gap:14rpx}
.patient-flow .shortcut-grid .shortcut{flex:1 1 46%;margin:0;min-height:96rpx;background:#e4f1ee;color:#145e53;border:2rpx solid #b8d5ce;font-size:29rpx;font-weight:600;padding:16rpx}
.patient-flow .more-card{padding:6rpx 26rpx 10rpx}
.patient-flow .more-links navigator:last-child{border-bottom:0}

/* 18551: report notices and the report body. The project heading, clinic and
   long report text wrap at any character; the body keeps its own paragraphs. */
.patient-report .report-body{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;margin:4rpx 0 8rpx}
.patient-report .fact-row text:last-child{overflow-wrap:anywhere;text-align:right}

/* 18551: the row that opened the report keeps a visible return anchor after
   the list is re-read; the border is the only decoration it adds. */
.patient-report .notice-return{border-color:#0c6d60;box-shadow:0 0 0 4rpx #0c6d601f}
.patient-report .notice-return .section-title{color:#0b5f54}

/* 18552: one bill per row; the number wraps without widening the card. */
.patient-flow .billing-no{font-size:27rpx;word-break:break-all;margin:4rpx 0}

/* The Beijing-time suffix stays one unit at every font size; without this it
   can split into 北京 / 时间 once the time line wraps. */
.patient-flow .tz{white-space:nowrap}

/* 18555: the appointment screens follow the WeChat font size setting.
   The default tier keeps the existing hierarchy; larger steps raise every
   patient-facing size, including the original and proposed times, helper
   text, buttons and the consent label. Long text wraps and the page scrolls;
   nothing is clipped or pushed sideways. */
.patient-flow.text-scale-compact{font-size:28rpx}
.patient-flow.text-scale-compact .title,.patient-flow.text-scale-compact .service-hero .title{font-size:42rpx}
.patient-flow.text-scale-compact .section-title{font-size:32rpx}
