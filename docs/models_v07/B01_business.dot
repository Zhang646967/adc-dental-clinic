digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.15",nodesep="0.25",ranksep="0.55",label="B01 业务用例图",labelloc=t,fontsize=18,fontname="Noto Sans CJK SC"];
node [fontname="Noto Sans CJK SC",fontsize=13,color="#27483f"]; edge [color="#536960",arrowhead=none];
