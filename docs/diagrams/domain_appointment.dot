digraph G {
 graph [rankdir=TB, bgcolor="white", pad=.22,nodesep=.65,ranksep=.8,splines=polyline];
 node [shape=record,fontname="Noto Sans CJK SC",fontsize=18,margin=".18,.12",color="#334155",penwidth=1.3];
 edge [dir=none,fontname="Noto Sans CJK SC",fontsize=14,color="#475569",labeldistance=2.2];
 clinic [label="{诊所\nClinic|界定业务与授权范围}"];
 user [label="{账号\nUserAccount|经办、执行与复核责任}"];
 visit [label="{已取消的\nVisit|保留原发起方与取消说明}"];
 follow [label="{原因跟进\nCancellationFollowUp|核实分类、联系结果、责任与期限\l另约须关联真实预约\l}"];
 measure [label="{改进措施\nAppointmentImprovement|诊所 × 星期 × 开始时段\l原窗口快照、执行与独立复核\l}"];
 new_visit [label="{另约\nVisit|同店同患者的正式预约}"];
 event [label="{办理历史\nAppointmentActionEvent|操作编号、经办人、当时快照\l只属于跟进或措施之一（xor）\l只追加，重复确认返回原结果\l}"];
 clinic -> visit [taillabel="1",headlabel="0..*",label="发生"];
 clinic -> measure [taillabel="1",headlabel="0..*",label="安排"];
 visit -> follow [taillabel="1",headlabel="0..1",label="跟进"];
 user -> follow [taillabel="1",headlabel="0..*",label="负责联系"];
 user -> measure [taillabel="1",headlabel="0..*",label="负责执行"];
 follow -> new_visit [taillabel="0..*",headlabel="0..1",label="核实另约",constraint=false];
 follow -> event [taillabel="0..1",headlabel="0..*",label="保留每次核实"];
 measure -> event [taillabel="0..1",headlabel="0..*",label="保留每次办理"];
 user -> event [taillabel="1",headlabel="0..*",label="经办",style=dashed,constraint=false];
 {rank=same;clinic;user;}
 {rank=same;follow;measure;}
 }
