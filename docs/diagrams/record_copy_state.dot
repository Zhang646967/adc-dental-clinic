digraph State {
 graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.5",ranksep="0.65",splines=polyline];
 node [shape=box,fixedsize=true,width=2.95,height=0.82,style="rounded,filled",fillcolor="#edf4f0",color="#345e56",fontname="Noto Sans CJK SC",fontsize=16];
 edge [color="#345e56",fontname="Noto Sans CJK SC",fontsize=12,arrowsize=0.7];
 pending [label="待身份、用途核验"];
 info [label="待补充材料",fillcolor="#fff3e6"];
 review [label="待独立医务审核"];
 approved [label="审核通过、待生成"];
 failed [label="生成失败",fillcolor="#fff3e6"];
 ready [label="副本就绪，可领取"];
 delivered [label="已记录交付响应"];
 terminal [label="未通过／撤回／撤销",fillcolor="#fff3e6"];
 {rank=same;info;review;}
 {rank=same;approved;failed;}
 pending -> review [label="核验通过"];
 pending -> info [label="退回"];
 info -> pending [label="补充提交"];
 review -> info [label="退回"];
 review -> approved [label="批准"];
 approved -> failed [label="生成失败"];
 failed -> approved [label="明确重试"];
 approved -> ready [label="生成成功"];
 ready -> delivered [label="确认领取"];
 delivered -> terminal [label="撤销"];
 ready -> terminal [constraint=false];
 pending -> terminal [label="拒绝／撤回",constraint=false];
 review -> terminal [label="不通过／撤回",constraint=false];
}
