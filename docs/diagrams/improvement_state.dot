digraph G {
 graph [rankdir=TB,bgcolor="white",pad=.4,nodesep=.5,ranksep=.7,splines=polyline];
 node [shape=box,style=rounded,fontname="Noto Sans CJK SC",fontsize=18,margin=".18,.12",color="#334155",penwidth=1.3];
 edge [fontname="Noto Sans CJK SC",fontsize=14,color="#475569",arrowsize=.7];
 initial [shape=point,width=.14];
 OPEN [label="待开始 OPEN\n计划、责任与原窗口"];
 WORKING [label="执行中 WORKING\n保留实际办理依据"];
 READY [label="待复核 READY\n执行人已明确提交"];
 CLOSED [label="已复核 CLOSED\n后续窗口及复核依据"];
 CANCELLED [label="已终止 CANCELLED\n保留终止原因"];
 initial -> OPEN [label="主管建立"];
 OPEN -> WORKING [label="负责人开始"];
 WORKING -> READY [label="负责人提交\n／保存实际执行"];
 READY -> CLOSED [label="另一主管复核\n[独立、完整后续窗口]\n／保存评价与数量"];
 READY -> WORKING [label="另一主管退回\n／说明待补事项",constraint=false];
 WORKING -> OPEN [label="主管重新分配",constraint=false];
 READY -> OPEN [label="主管重新分配\n[含原负责人失效]",constraint=false];
 OPEN -> CANCELLED [label="主管终止"];
 WORKING -> CANCELLED [label="主管终止"];
 READY -> CANCELLED [label="主管终止"];
 {rank=same;READY;CANCELLED;}
 }
