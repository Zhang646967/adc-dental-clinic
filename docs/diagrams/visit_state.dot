digraph G {
 graph [rankdir=TB,bgcolor="white",pad=.4,nodesep=.55,ranksep=.75,splines=polyline];
 node [shape=box,style=rounded,fontname="Noto Sans CJK SC",fontsize=18,margin=".18,.12",color="#334155",penwidth=1.3];
 edge [fontname="Noto Sans CJK SC",fontsize=14,color="#475569",arrowsize=.7];
 initial [shape=point,width=.14];
 SCHEDULED [label="已预约\nSCHEDULED"];
 CHECKED_IN [label="已到诊\nCHECKED_IN"];
 COMPLETED [label="治疗完成\nCOMPLETED"];
 CLOSED_NO_TREATMENT [label="无治疗关闭\nCLOSED_NO_TREATMENT"];
 CANCELLED [label="已取消\nCANCELLED"];
 NO_SHOW [label="核实爽约\nNO_SHOW"];
 RESCHEDULED [label="改期前身\nRESCHEDULED"];
 initial -> SCHEDULED [label="明确确认／建立预约"];
 SCHEDULED -> CHECKED_IN [label="到诊登记 [前台核实]\n／记录实际到诊时间"];
 CHECKED_IN -> COMPLETED [label="结束接诊\n[治疗及费用核对通过]\n／发布版本和结算单"];
 CHECKED_IN -> CLOSED_NO_TREATMENT [label="无治疗结束\n[记录依据]\n／发布零额结算单"];
 SCHEDULED -> CANCELLED [label="取消 [权限与原因有效]\n／保留发起方与原说明"];
 SCHEDULED -> NO_SHOW [label="核实未到\n[已到预约结束]\n／记录核实依据"];
 SCHEDULED -> RESCHEDULED [label="确认改期\n[新方案可用]\n／原子创建唯一后继"];
 CANCELLED -> NO_SHOW -> RESCHEDULED [style=invis,weight=8];
 {rank=same;COMPLETED;CLOSED_NO_TREATMENT;}
 }
