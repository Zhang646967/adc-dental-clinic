digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_external_identity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_external_identity</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="provider">provider</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="app_id">app_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="subject">subject</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_local_identity_code" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_local_identity_code</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="purpose">purpose</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="identity_id">identity_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="digest">digest</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="consumed_at">consumed_at ?</TD></TR></TABLE>>];
"adc_sms_challenge" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_sms_challenge</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="purpose">purpose</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="attempts">attempts</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="consumed_at">consumed_at ?</TD></TR></TABLE>>];
"adc_account_phone" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_account_phone</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="source">source</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_account_identity_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_account_identity_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="identity_id">identity_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR></TABLE>>];
"adc_workspace_context" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_workspace_context</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="login_channel">login_channel</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="role">role</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_user" -> "adc_external_identity" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_external_identity.user_id references adc_user.id; 0..*:0..1"];
"adc_external_identity" -> "adc_local_identity_code" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_local_identity_code.identity_id references adc_external_identity.id; 0..*:0..1"];
"adc_user" -> "adc_local_identity_code" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_local_identity_code.user_id references adc_user.id; 0..*:0..1"];
"adc_user" -> "adc_sms_challenge" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_sms_challenge.user_id references adc_user.id; 0..*:0..1"];
"adc_user" -> "adc_account_phone" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_account_phone.user_id references adc_user.id; 0..1:1"];
"adc_user" -> "adc_account_identity_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_account_identity_event.user_id references adc_user.id; 0..*:1"];
"adc_external_identity" -> "adc_account_identity_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_account_identity_event.identity_id references adc_external_identity.id; 0..*:0..1"];
"adc_user" -> "adc_workspace_context" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_workspace_context.user_id references adc_user.id; 0..*:1"];
}
