digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR></TABLE>>];
"adc_clinical_reviewer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_reviewer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="can_review_archives">can_review_archives</TD></TR></TABLE>>];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_archive" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_archive</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="responsible_id">responsible_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="due_at">due_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="supplement_due_at">supplement_due_at ?</TD></TR></TABLE>>];
"adc_clinical_document_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="document_id">document_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_archive_submission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_submission</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="document_version_id">document_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="submitted_by_id">submitted_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="assigned_reviewer_id">assigned_reviewer_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewer_id">reviewer_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="source_digest">source_digest</TD></TR></TABLE>>];
"adc_user" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.user_id references adc_user.id; 0..*:1"];
"adc_clinical_encounter" -> "adc_clinical_archive" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_archive.encounter_id references adc_clinical_encounter.id; 0..1:1"];
"adc_user" -> "adc_clinical_archive" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_archive.responsible_id references adc_user.id; 0..*:1"];
"adc_clinical_archive" -> "adc_archive_submission" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_submission.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_clinical_document_version" -> "adc_archive_submission" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_submission.document_version_id references adc_clinical_document_version.id; 0..*:0..1"];
"adc_user" -> "adc_archive_submission" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_submission.submitted_by_id references adc_user.id; 0..*:1"];
"adc_clinical_reviewer" -> "adc_archive_submission" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_submission.assigned_reviewer_id references adc_clinical_reviewer.id; 0..*:1"];
"adc_user" -> "adc_archive_submission" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_submission.reviewed_by_id references adc_user.id; 0..*:0..1"];
"adc_clinical_reviewer" -> "adc_archive_submission" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_submission.reviewer_id references adc_clinical_reviewer.id; 0..*:0..1"];
}
