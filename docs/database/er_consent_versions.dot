digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR></TABLE>>];
"adc_treatment_step" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_step</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR></TABLE>>];
"adc_plan_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_plan_step_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_step_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="tooth">tooth ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="surface">surface</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_medical_consent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_consent</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="opened_by_id">opened_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_consent_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_consent_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="consent_id">consent_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prepared_by_id">prepared_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="scope_digest">scope_digest</TD></TR></TABLE>>];
"adc_clinical_record_version" -> "adc_plan_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_version.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_plan_version" -> "adc_plan_step_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_step_version.version_id references adc_plan_version.id; 0..*:1"];
"adc_treatment_step" -> "adc_plan_step_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_step_version.step_id references adc_treatment_step.id; 0..*:1"];
"adc_treatment_step" -> "adc_medical_consent" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_medical_consent.step_id references adc_treatment_step.id; 0..1:1"];
"adc_user" -> "adc_medical_consent" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_consent.opened_by_id references adc_user.id; 0..*:1"];
"adc_medical_consent" -> "adc_consent_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_version.consent_id references adc_medical_consent.id; 0..*:1"];
"adc_consent_version" -> "adc_consent_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_consent_version.previous_id references adc_consent_version.id; 0..1:0..1"];
"adc_plan_step_version" -> "adc_consent_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_version.step_version_id references adc_plan_step_version.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_consent_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_version.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_user" -> "adc_consent_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_version.prepared_by_id references adc_user.id; 0..*:1"];
}
