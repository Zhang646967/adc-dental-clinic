digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_plan_step_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_step_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR></TABLE>>];
"adc_consent_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_consent_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="proxy_version_id">proxy_version_id ?</TD></TR></TABLE>>];
"adc_consent_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_consent_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="source">source</TD></TR></TABLE>>];
"adc_medical_proxy_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_proxy_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_clinical_consent_rule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_consent_rule</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="treatment_type_id">treatment_type_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="mode">mode</TD></TR></TABLE>>];
"adc_treatment_preflight" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_preflight</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="rule_id">rule_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="consent_version_id">consent_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="consent_decision_id">consent_decision_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="proxy_version_id">proxy_version_id ?</TD></TR></TABLE>>];
"adc_performed_procedure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_performed_procedure</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="preflight_id">preflight_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="charge_line_id">charge_line_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_plan_step_version" -> "adc_consent_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_version.step_version_id references adc_plan_step_version.id; 0..*:1"];
"adc_medical_proxy_version" -> "adc_consent_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_consent_version.proxy_version_id references adc_medical_proxy_version.id; 0..*:0..1"];
"adc_consent_version" -> "adc_consent_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_consent_event.version_id references adc_consent_version.id; 0..*:1"];
"adc_plan_step_version" -> "adc_treatment_preflight" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_treatment_preflight.step_version_id references adc_plan_step_version.id; 0..*:0..1"];
"adc_clinical_consent_rule" -> "adc_treatment_preflight" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_treatment_preflight.rule_id references adc_clinical_consent_rule.id; 0..*:1"];
"adc_consent_version" -> "adc_treatment_preflight" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_treatment_preflight.consent_version_id references adc_consent_version.id; 0..*:0..1"];
"adc_consent_event" -> "adc_treatment_preflight" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_treatment_preflight.consent_decision_id references adc_consent_event.id; 0..*:0..1"];
"adc_medical_proxy_version" -> "adc_treatment_preflight" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_treatment_preflight.proxy_version_id references adc_medical_proxy_version.id; 0..*:0..1"];
"adc_plan_step_version" -> "adc_performed_procedure" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_performed_procedure.step_version_id references adc_plan_step_version.id; 0..*:0..1"];
"adc_treatment_preflight" -> "adc_performed_procedure" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_performed_procedure.preflight_id references adc_treatment_preflight.id; 0..1:0..1"];
}
