digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_visit_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision_no">revision_no</TD></TR></TABLE>>];
"adc_treatment_record" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_record</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="record_version_id">record_version_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="line_no">line_no</TD></TR></TABLE>>];
"adc_invoice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_invoice</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="current_record_version_id">current_record_version_id</TD></TR></TABLE>>];
"adc_cash_entry" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cash_entry</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="invoice_id">invoice_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_cash_evidence" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cash_evidence</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="cash_entry_id">cash_entry_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="account_id">account_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="version">version</TD></TR></TABLE>>];
"adc_payment_account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_payment_account</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_statement_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_statement_line</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="account_id">account_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="transaction_id">transaction_id</TD></TR></TABLE>>];
"adc_reconciliation_match" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_reconciliation_match</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="cash_entry_id">cash_entry_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="evidence_id">evidence_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_visit" -> "adc_visit_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit_record_version.visit_id references adc_visit.id; 0..*:1"];
"adc_visit_record_version" -> "adc_treatment_record" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_treatment_record.record_version_id references adc_visit_record_version.id; 0..*:1"];
"adc_visit" -> "adc_invoice" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_invoice.visit_id references adc_visit.id; 0..1:1"];
"adc_visit_record_version" -> "adc_invoice" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_invoice.current_record_version_id references adc_visit_record_version.id; 0..1:1"];
"adc_invoice" -> "adc_cash_entry" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_cash_entry.invoice_id references adc_invoice.id; 0..*:0..1"];
"adc_cash_entry" -> "adc_cash_evidence" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_evidence.cash_entry_id references adc_cash_entry.id; 0..*:1"];
"adc_payment_account" -> "adc_cash_evidence" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_evidence.account_id references adc_payment_account.id; 0..*:1"];
"adc_payment_account" -> "adc_statement_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_statement_line.account_id references adc_payment_account.id; 0..*:1"];
"adc_cash_entry" -> "adc_reconciliation_match" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reconciliation_match.cash_entry_id references adc_cash_entry.id; 0..*:1"];
"adc_cash_evidence" -> "adc_reconciliation_match" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reconciliation_match.evidence_id references adc_cash_evidence.id; 0..*:1"];
"adc_statement_line" -> "adc_reconciliation_match" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reconciliation_match.line_id references adc_statement_line.id; 0..*:1"];
}
