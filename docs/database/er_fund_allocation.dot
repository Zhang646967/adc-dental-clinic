digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_statement_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_statement_line</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="account_id">account_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="direction">direction</TD></TR></TABLE>>];
"adc_reconciliation_match" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_reconciliation_match</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_fund_transfer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_fund_transfer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_statement_use" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_statement_use</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="cash_match_id">cash_match_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="fund_transfer_id">fund_transfer_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_fund_allocation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_fund_allocation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="transfer_id">transfer_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="total">total</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_fund_allocation_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_fund_allocation_line</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="allocation_id">allocation_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="claim_id">claim_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR></TABLE>>];
"adc_insurance_settlement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_settlement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="fund_amount">fund_amount</TD></TR></TABLE>>];
"adc_statement_line" -> "adc_reconciliation_match" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reconciliation_match.line_id references adc_statement_line.id; 0..*:1"];
"adc_statement_line" -> "adc_fund_transfer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_transfer.line_id references adc_statement_line.id; 0..*:1"];
"adc_statement_line" -> "adc_statement_use" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_statement_use.line_id references adc_statement_line.id; 0..*:1"];
"adc_reconciliation_match" -> "adc_statement_use" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_statement_use.cash_match_id references adc_reconciliation_match.id; 0..1:0..1"];
"adc_fund_transfer" -> "adc_statement_use" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_statement_use.fund_transfer_id references adc_fund_transfer.id; 0..1:0..1"];
"adc_fund_transfer" -> "adc_fund_allocation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_allocation.transfer_id references adc_fund_transfer.id; 0..*:1"];
"adc_fund_allocation" -> "adc_fund_allocation_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_allocation_line.allocation_id references adc_fund_allocation.id; 0..*:1"];
"adc_insurance_settlement" -> "adc_fund_allocation_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_allocation_line.claim_id references adc_insurance_settlement.id; 0..*:1"];
}
