digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_performed_procedure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_performed_procedure</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="preflight_id">preflight_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="charge_line_id">charge_line_id ?</TD></TR></TABLE>>];
"adc_procedure_gap" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_procedure_gap</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="performed_id">performed_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="recorded_by_id">recorded_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_procedure_gap_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_procedure_gap_review</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="gap_id">gap_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewer_id">reviewer_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR></TABLE>>];
"adc_clinical_reviewer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_reviewer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR></TABLE>>];
"adc_performed_procedure" -> "adc_procedure_gap" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_procedure_gap.performed_id references adc_performed_procedure.id; 0..1:1"];
"adc_user" -> "adc_procedure_gap" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_procedure_gap.recorded_by_id references adc_user.id; 0..*:1"];
"adc_procedure_gap" -> "adc_procedure_gap_review" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_procedure_gap_review.gap_id references adc_procedure_gap.id; 0..1:1"];
"adc_clinical_reviewer" -> "adc_procedure_gap_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_procedure_gap_review.reviewer_id references adc_clinical_reviewer.id; 0..*:1"];
"adc_user" -> "adc_procedure_gap_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_procedure_gap_review.actor_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.user_id references adc_user.id; 0..*:1"];
}
