digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_treatment_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_type</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="unit_definition">unit_definition</TD></TR></TABLE>>];
"adc_insurance_catalogue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_catalogue</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="region">region</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="version_code">version_code</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="review_attempt">review_attempt</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="effective_on">effective_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="source_digest">source_digest</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_insurance_policy_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_policy_item</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="catalogue_id">catalogue_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="unit">unit ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="payment_class">payment_class</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="pre_self_pay_percent">pre_self_pay_percent ?</TD></TR></TABLE>>];
"adc_insurance_arrangement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_arrangement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="catalogue_id">catalogue_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_on">starts_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_on">ends_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_insurance_fee_mapping" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_fee_mapping</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="treatment_type_id">treatment_type_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="policy_item_id">policy_item_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="policy_units_per_fee">policy_units_per_fee</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_insurance_catalogue" -> "adc_insurance_catalogue" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_insurance_catalogue.previous_id references adc_insurance_catalogue.id; 0..1:0..1"];
"adc_insurance_catalogue" -> "adc_insurance_policy_item" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_policy_item.catalogue_id references adc_insurance_catalogue.id; 0..*:1"];
"adc_clinic" -> "adc_insurance_arrangement" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_arrangement.clinic_id references adc_clinic.id; 0..*:1"];
"adc_insurance_catalogue" -> "adc_insurance_arrangement" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_arrangement.catalogue_id references adc_insurance_catalogue.id; 0..*:1"];
"adc_clinic" -> "adc_insurance_fee_mapping" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_fee_mapping.clinic_id references adc_clinic.id; 0..*:1"];
"adc_treatment_type" -> "adc_insurance_fee_mapping" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_fee_mapping.treatment_type_id references adc_treatment_type.id; 0..*:1"];
"adc_insurance_policy_item" -> "adc_insurance_fee_mapping" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_fee_mapping.policy_item_id references adc_insurance_policy_item.id; 0..*:1"];
}
