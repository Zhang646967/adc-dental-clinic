digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_cash_entry" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cash_entry</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="advance_patient_id">advance_patient_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_advance_allocation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_advance_allocation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="receipt_id">receipt_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prepared_by_id">prepared_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="total">total</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_advance_allocation_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_advance_allocation_line</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="allocation_id">allocation_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="invoice_id">invoice_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="record_version_id">record_version_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR></TABLE>>];
"adc_invoice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_invoice</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="current_record_version_id">current_record_version_id</TD></TR></TABLE>>];
"adc_visit_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision_no">revision_no</TD></TR></TABLE>>];
"adc_cash_entry" -> "adc_advance_allocation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_advance_allocation.receipt_id references adc_cash_entry.id; 0..*:1"];
"adc_user" -> "adc_advance_allocation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_advance_allocation.prepared_by_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_advance_allocation" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_advance_allocation.reviewed_by_id references adc_user.id; 0..*:0..1"];
"adc_advance_allocation" -> "adc_advance_allocation_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_advance_allocation_line.allocation_id references adc_advance_allocation.id; 0..*:1"];
"adc_invoice" -> "adc_advance_allocation_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_advance_allocation_line.invoice_id references adc_invoice.id; 0..*:1"];
"adc_visit_record_version" -> "adc_advance_allocation_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_advance_allocation_line.record_version_id references adc_visit_record_version.id; 0..*:1"];
"adc_visit_record_version" -> "adc_invoice" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_invoice.current_record_version_id references adc_visit_record_version.id; 0..1:1"];
}
