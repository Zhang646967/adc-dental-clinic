digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_prescription_decision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_prescription_decision</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR></TABLE>>];
"adc_pharmacy_quote" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_pharmacy_quote</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="approval_id">approval_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prepared_by_id">prepared_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="duty_id">duty_id</TD></TR></TABLE>>];
"adc_pharmacy_quote_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_pharmacy_quote_line</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="quote_id">quote_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="item_id">item_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ordered_quantity">ordered_quantity</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD></TR></TABLE>>];
"adc_dispense_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dispense_movement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="original_issue_id">original_issue_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR></TABLE>>];
"adc_pharmacy_stop" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_pharmacy_stop</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="approval_id">approval_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="stopped_at">stopped_at</TD></TR></TABLE>>];
"adc_medication_charge" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medication_charge</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="record_version_id">record_version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="quote_line_id">quote_line_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="through_movement_id">through_movement_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="line_amount">line_amount</TD></TR></TABLE>>];
"adc_visit_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision_no">revision_no</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="outcome">outcome</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD></TR></TABLE>>];
"adc_invoice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_invoice</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="current_record_version_id">current_record_version_id</TD></TR></TABLE>>];
"adc_prescription_decision" -> "adc_pharmacy_quote" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_pharmacy_quote.approval_id references adc_prescription_decision.id; 0..1:1"];
"adc_pharmacy_quote" -> "adc_pharmacy_quote_line" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_pharmacy_quote_line.quote_id references adc_pharmacy_quote.id; 0..*:1"];
"adc_pharmacy_quote_line" -> "adc_dispense_movement" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dispense_movement.line_id references adc_pharmacy_quote_line.id; 0..*:1"];
"adc_dispense_movement" -> "adc_dispense_movement" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_dispense_movement.original_issue_id references adc_dispense_movement.id; 0..*:0..1"];
"adc_prescription_decision" -> "adc_pharmacy_stop" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_pharmacy_stop.approval_id references adc_prescription_decision.id; 0..1:1"];
"adc_visit_record_version" -> "adc_medication_charge" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medication_charge.record_version_id references adc_visit_record_version.id; 0..*:1"];
"adc_pharmacy_quote_line" -> "adc_medication_charge" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medication_charge.quote_line_id references adc_pharmacy_quote_line.id; 0..*:1"];
"adc_dispense_movement" -> "adc_medication_charge" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medication_charge.through_movement_id references adc_dispense_movement.id; 0..*:1"];
"adc_visit_record_version" -> "adc_invoice" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_invoice.current_record_version_id references adc_visit_record_version.id; 0..1:1"];
}
