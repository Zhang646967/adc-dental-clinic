digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_plan_step_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_step_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="requires_lab">requires_lab ?</TD></TR></TABLE>>];
"adc_treatment_step" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_step</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_lab_case" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_lab_case</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="cycle">cycle</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="coordinator_id">coordinator_id ?</TD></TR></TABLE>>];
"adc_lab_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_lab_review</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="case_id">case_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="target_step_version_id">target_step_version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="cycle">cycle</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="decision">decision</TD></TR></TABLE>>];
"adc_lab_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_lab_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="case_id">case_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="review_id">review_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_treatment_step" -> "adc_plan_step_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_step_version.step_id references adc_treatment_step.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_lab_case" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_case.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_plan_step_version" -> "adc_lab_case" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_case.step_version_id references adc_plan_step_version.id; 0..*:1"];
"adc_lab_case" -> "adc_lab_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_review.case_id references adc_lab_case.id; 0..*:1"];
"adc_plan_step_version" -> "adc_lab_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_review.target_step_version_id references adc_plan_step_version.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_lab_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_review.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_lab_case" -> "adc_lab_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_lab_event.case_id references adc_lab_case.id; 0..*:1"];
"adc_lab_review" -> "adc_lab_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_lab_event.review_id references adc_lab_review.id; 0..*:0..1"];
}
