digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_stock_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_stock_item</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="prescription_item_id">prescription_item_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="unit">unit</TD></TR></TABLE>>];
"adc_stock_lot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_stock_lot</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="item_id">item_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="expires_on">expires_on</TD></TR></TABLE>>];
"adc_stock_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_stock_movement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="lot_id">lot_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dispense_id">dispense_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="execution_id">execution_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="reverses_id">reverses_id ?</TD></TR></TABLE>>];
"adc_stock_recall" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_stock_recall</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="lot_id">lot_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR></TABLE>>];
"adc_dispense_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dispense_movement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="original_issue_id">original_issue_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="requires_batch">requires_batch</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR></TABLE>>];
"adc_nursing_execution" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_nursing_execution</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="issue_id">issue_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="performed_id">performed_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR></TABLE>>];
"adc_stock_item" -> "adc_stock_lot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_stock_lot.item_id references adc_stock_item.id; 0..*:1"];
"adc_stock_lot" -> "adc_stock_movement" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_stock_movement.lot_id references adc_stock_lot.id; 0..*:1"];
"adc_dispense_movement" -> "adc_stock_movement" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_stock_movement.dispense_id references adc_dispense_movement.id; 0..1:0..1"];
"adc_nursing_execution" -> "adc_stock_movement" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_stock_movement.execution_id references adc_nursing_execution.id; 0..1:0..1"];
"adc_stock_movement" -> "adc_stock_movement" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_stock_movement.reverses_id references adc_stock_movement.id; 0..1:0..1"];
"adc_stock_lot" -> "adc_stock_recall" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_stock_recall.lot_id references adc_stock_lot.id; 0..1:1"];
"adc_dispense_movement" -> "adc_dispense_movement" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_dispense_movement.original_issue_id references adc_dispense_movement.id; 0..*:0..1"];
"adc_visit" -> "adc_nursing_execution" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_nursing_execution.visit_id references adc_visit.id; 0..*:1"];
"adc_dispense_movement" -> "adc_nursing_execution" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_nursing_execution.issue_id references adc_dispense_movement.id; 0..*:0..1"];
}
