digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR></TABLE>>];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD></TR></TABLE>>];
"adc_examination_project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_project</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_examination_duty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_duty</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="project_id">project_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_examination_order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_order</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="project_id">project_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="performed_by_id">performed_by_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="performed_at">performed_at ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="active_release_id">active_release_id ?</TD></TR></TABLE>>];
"adc_examination_report" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_report</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="order_id">order_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="correction_reason">correction_reason</TD></TR></TABLE>>];
"adc_examination_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="order_id">order_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="report_id">report_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="occurred_at">occurred_at</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_visit" -> "adc_clinical_encounter" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_encounter.visit_id references adc_visit.id; 0..1:1"];
"adc_clinical_encounter" -> "adc_clinical_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_record_version.encounter_id references adc_clinical_encounter.id; 0..*:1"];
"adc_booking_service" -> "adc_examination_project" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_project.service_id references adc_booking_service.id; 0..*:1"];
"adc_examination_project" -> "adc_examination_duty" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_duty.project_id references adc_examination_project.id; 0..*:1"];
"adc_user" -> "adc_examination_duty" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_duty.user_id references adc_user.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_examination_order" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_order.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_examination_project" -> "adc_examination_order" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_order.project_id references adc_examination_project.id; 0..*:1"];
"adc_user" -> "adc_examination_order" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_examination_order.performed_by_id references adc_user.id; 0..*:0..1"];
"adc_examination_event" -> "adc_examination_order" [arrowtail="teeodot", arrowhead="crowodot", constraint=false, tooltip="adc_examination_order.active_release_id references adc_examination_event.id; 0..*:0..1"];
"adc_examination_order" -> "adc_examination_report" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_report.order_id references adc_examination_order.id; 0..*:1"];
"adc_examination_order" -> "adc_examination_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_event.order_id references adc_examination_order.id; 0..*:1"];
"adc_examination_report" -> "adc_examination_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_examination_event.report_id references adc_examination_report.id; 0..*:0..1"];
"adc_user" -> "adc_examination_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_event.actor_id references adc_user.id; 0..*:1"];
}
