digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR></TABLE>>];
"adc_cost_month" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cost_month</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="year">year</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="month">month</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="coverage">coverage</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_monthly_cost" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_monthly_cost</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="period_id">period_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="category">category</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="equipment_event_id">equipment_event_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="replaces_id">replaces_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prepared_by_id">prepared_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR></TABLE>>];
"adc_equipment_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_equipment_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="asset_id">asset_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="cost">cost ?</TD></TR></TABLE>>];
"adc_management_report" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_management_report</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="period_id">period_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="digest">digest</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="confirmed_by_id">confirmed_by_id</TD></TR></TABLE>>];
"adc_cost_allocation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cost_allocation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="report_id">report_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="shift_minutes">shift_minutes</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="direct_cost">direct_cost</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="shared_cost">shared_cost</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="production">production</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="contribution">contribution</TD></TR></TABLE>>];
"adc_management_action" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_management_action</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="period_id">period_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="cost_id">cost_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="report_id">report_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_clinic" -> "adc_cost_month" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_cost_month.clinic_id references adc_clinic.id; 0..*:0..1"];
"adc_cost_month" -> "adc_monthly_cost" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_monthly_cost.period_id references adc_cost_month.id; 0..*:1"];
"adc_dentist" -> "adc_monthly_cost" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_monthly_cost.dentist_id references adc_dentist.id; 0..*:0..1"];
"adc_equipment_event" -> "adc_monthly_cost" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_monthly_cost.equipment_event_id references adc_equipment_event.id; 0..*:0..1"];
"adc_monthly_cost" -> "adc_monthly_cost" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_monthly_cost.replaces_id references adc_monthly_cost.id; 0..*:0..1"];
"adc_cost_month" -> "adc_management_report" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_management_report.period_id references adc_cost_month.id; 0..*:1"];
"adc_management_report" -> "adc_cost_allocation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cost_allocation.report_id references adc_management_report.id; 0..*:1"];
"adc_dentist" -> "adc_cost_allocation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cost_allocation.dentist_id references adc_dentist.id; 0..*:1"];
"adc_cost_month" -> "adc_management_action" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_management_action.period_id references adc_cost_month.id; 0..*:1"];
"adc_monthly_cost" -> "adc_management_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_management_action.cost_id references adc_monthly_cost.id; 0..*:0..1"];
"adc_management_report" -> "adc_management_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_management_action.report_id references adc_management_report.id; 0..*:0..1"];
}
