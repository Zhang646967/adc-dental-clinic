digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR></TABLE>>];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_public_profile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_public_profile</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="submitted_version_id">submitted_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="published_version_id">published_version_id ?</TD></TR></TABLE>>];
"adc_profile_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_profile_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="profile_id">profile_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="content">content</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="submitted_by_id">submitted_by_id</TD></TR></TABLE>>];
"adc_profile_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_profile_media</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="profile_id">profile_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="digest">digest</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="width">width</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="height">height</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="alt_text">alt_text</TD></TR></TABLE>>];
"adc_dentist_clinic_affiliation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist_clinic_affiliation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="published_version_id">published_version_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="listing_published">listing_published</TD></TR></TABLE>>];
"adc_profile_action" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_profile_action</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="profile_id">profile_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="affiliation_id">affiliation_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_dentist" -> "adc_public_profile" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_public_profile.dentist_id references adc_dentist.id; 0..1:0..1"];
"adc_clinic" -> "adc_public_profile" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_public_profile.clinic_id references adc_clinic.id; 0..1:0..1"];
"adc_profile_version" -> "adc_public_profile" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_public_profile.submitted_version_id references adc_profile_version.id; 0..*:0..1"];
"adc_profile_version" -> "adc_public_profile" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_public_profile.published_version_id references adc_profile_version.id; 0..*:0..1"];
"adc_public_profile" -> "adc_profile_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_profile_version.profile_id references adc_public_profile.id; 0..*:1"];
"adc_public_profile" -> "adc_profile_media" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_profile_media.profile_id references adc_public_profile.id; 0..*:1"];
"adc_dentist" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.dentist_id references adc_dentist.id; 0..*:1"];
"adc_clinic" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.clinic_id references adc_clinic.id; 0..*:1"];
"adc_profile_version" -> "adc_dentist_clinic_affiliation" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.published_version_id references adc_profile_version.id; 0..*:0..1"];
"adc_public_profile" -> "adc_profile_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_profile_action.profile_id references adc_public_profile.id; 0..*:0..1"];
"adc_dentist_clinic_affiliation" -> "adc_profile_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_profile_action.affiliation_id references adc_dentist_clinic_affiliation.id; 0..*:0..1"];
"adc_profile_version" -> "adc_profile_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_profile_action.version_id references adc_profile_version.id; 0..*:0..1"];
"adc_clinic" -> "adc_profile_action" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_profile_action.clinic_id references adc_clinic.id; 0..*:0..1"];
}
