digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="created_in_clinic_id">created_in_clinic_id</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_cash_entry" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cash_entry</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="advance_patient_id">advance_patient_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="occurred_on">occurred_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prepared_by_id">prepared_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR></TABLE>>];
"adc_payment_account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_payment_account</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR></TABLE>>];
"adc_cash_evidence" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cash_evidence</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="cash_entry_id">cash_entry_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="account_id">account_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="reference">reference</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="version">version</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_clinic" -> "adc_patient" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_patient.created_in_clinic_id references adc_clinic.id; 0..*:1"];
"adc_clinic" -> "adc_cash_entry" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_entry.clinic_id references adc_clinic.id; 0..*:1"];
"adc_patient" -> "adc_cash_entry" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_cash_entry.advance_patient_id references adc_patient.id; 0..*:0..1"];
"adc_user" -> "adc_cash_entry" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_entry.prepared_by_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_cash_entry" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_cash_entry.reviewed_by_id references adc_user.id; 0..*:0..1"];
"adc_clinic" -> "adc_payment_account" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_payment_account.clinic_id references adc_clinic.id; 0..*:1"];
"adc_cash_entry" -> "adc_cash_evidence" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_evidence.cash_entry_id references adc_cash_entry.id; 0..*:1"];
"adc_payment_account" -> "adc_cash_evidence" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_cash_evidence.account_id references adc_payment_account.id; 0..*:1"];
}
