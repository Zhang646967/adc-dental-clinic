digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_wait_offer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_wait_offer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id ?</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_treatment_room" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_room</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_resource_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_resource_plan</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="offer_id">offer_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="room_id">room_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="version">version</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_current">is_current</TD></TR></TABLE>>];
"adc_resource_claim" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_resource_claim</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="asset_id">asset_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="active">active</TD></TR></TABLE>>];
"adc_equipment_asset" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_equipment_asset</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="asset_code">asset_code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_resource_binding" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_resource_binding</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="asset_id">asset_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="room_id">room_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="shared">shared</TD></TR></TABLE>>];
"adc_visit" -> "adc_wait_offer" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_wait_offer.visit_id references adc_visit.id; 0..1:0..1"];
"adc_visit" -> "adc_resource_plan" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_resource_plan.visit_id references adc_visit.id; 0..*:0..1"];
"adc_wait_offer" -> "adc_resource_plan" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_resource_plan.offer_id references adc_wait_offer.id; 0..*:0..1"];
"adc_booking_service" -> "adc_resource_plan" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_plan.service_id references adc_booking_service.id; 0..*:1"];
"adc_treatment_room" -> "adc_resource_plan" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_plan.room_id references adc_treatment_room.id; 0..*:1"];
"adc_resource_plan" -> "adc_resource_claim" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_claim.plan_id references adc_resource_plan.id; 0..*:1"];
"adc_equipment_asset" -> "adc_resource_claim" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_claim.asset_id references adc_equipment_asset.id; 0..*:1"];
"adc_equipment_asset" -> "adc_resource_binding" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_resource_binding.asset_id references adc_equipment_asset.id; 0..1:1"];
"adc_treatment_room" -> "adc_resource_binding" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_resource_binding.room_id references adc_treatment_room.id; 0..*:0..1"];
}
