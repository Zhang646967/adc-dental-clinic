digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_record_copy_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_record_copy_request</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="recipient_id">recipient_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="pickup_until">pickup_until ?</TD></TR></TABLE>>];
"adc_record_copy_file" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_record_copy_file</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sha256">sha256</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="renderer">renderer</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR></TABLE>>];
"adc_record_copy_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_record_copy_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_user" -> "adc_record_copy_request" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_request.recipient_id references adc_user.id; 0..*:1"];
"adc_record_copy_request" -> "adc_record_copy_file" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_record_copy_file.request_id references adc_record_copy_request.id; 0..1:1"];
"adc_record_copy_request" -> "adc_record_copy_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_event.request_id references adc_record_copy_request.id; 0..*:1"];
"adc_user" -> "adc_record_copy_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_record_copy_event.actor_id references adc_user.id; 0..*:0..1"];
}
