digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_treatment_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_plan</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="origin_encounter_id">origin_encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_plan_draft" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_draft</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="base_version_id">base_version_id ?</TD></TR></TABLE>>];
"adc_plan_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_treatment_step" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_step</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="step_key">step_key</TD></TR></TABLE>>];
"adc_plan_step_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_step_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="requires_lab">requires_lab ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="definition_snapshot">definition_snapshot ?</TD></TR></TABLE>>];
"adc_clinical_encounter" -> "adc_clinical_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_record_version.encounter_id references adc_clinical_encounter.id; 0..*:1"];
"adc_clinical_encounter" -> "adc_treatment_plan" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_treatment_plan.origin_encounter_id references adc_clinical_encounter.id; 0..*:1"];
"adc_treatment_plan" -> "adc_plan_draft" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_plan_draft.plan_id references adc_treatment_plan.id; 0..1:1"];
"adc_clinical_record_version" -> "adc_plan_draft" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_draft.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_plan_version" -> "adc_plan_draft" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_plan_draft.base_version_id references adc_plan_version.id; 0..*:0..1"];
"adc_treatment_plan" -> "adc_plan_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_version.plan_id references adc_treatment_plan.id; 0..*:1"];
"adc_plan_version" -> "adc_plan_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_plan_version.previous_id references adc_plan_version.id; 0..1:0..1"];
"adc_clinical_record_version" -> "adc_plan_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_version.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_treatment_plan" -> "adc_treatment_step" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_treatment_step.plan_id references adc_treatment_plan.id; 0..*:1"];
"adc_plan_version" -> "adc_plan_step_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_step_version.version_id references adc_plan_version.id; 0..*:1"];
"adc_treatment_step" -> "adc_plan_step_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_step_version.step_id references adc_treatment_step.id; 0..*:1"];
}
