digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_examination_order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_order</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="active_release_id">active_release_id ?</TD></TR></TABLE>>];
"adc_examination_report" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_report</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="order_id">order_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR></TABLE>>];
"adc_examination_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="order_id">order_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="report_id">report_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="occurred_at">occurred_at</TD></TR></TABLE>>];
"adc_examination_notice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_notice</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="event_id">event_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="read_at">read_at ?</TD></TR></TABLE>>];
"adc_examination_followup" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_examination_followup</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="release_id">release_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="instruction_id">instruction_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="due_at">due_at ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_next_visit_instruction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_next_visit_instruction</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="earliest_on">earliest_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="latest_on">latest_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="completion_rule">completion_rule</TD></TR></TABLE>>];
"adc_plan_appointment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_appointment</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="instruction_id">instruction_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="report_followup_id">report_followup_id ?</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="replaces_visit_id">replaces_visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_examination_event" -> "adc_examination_order" [arrowtail="teeodot", arrowhead="crowodot", constraint=false, tooltip="adc_examination_order.active_release_id references adc_examination_event.id; 0..*:0..1"];
"adc_examination_order" -> "adc_examination_report" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_report.order_id references adc_examination_order.id; 0..*:1"];
"adc_examination_order" -> "adc_examination_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_event.order_id references adc_examination_order.id; 0..*:1"];
"adc_examination_report" -> "adc_examination_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_examination_event.report_id references adc_examination_report.id; 0..*:0..1"];
"adc_examination_event" -> "adc_examination_notice" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_examination_notice.event_id references adc_examination_event.id; 0..1:1"];
"adc_examination_event" -> "adc_examination_followup" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_followup.release_id references adc_examination_event.id; 0..*:1"];
"adc_next_visit_instruction" -> "adc_examination_followup" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_examination_followup.instruction_id references adc_next_visit_instruction.id; 0..*:0..1"];
"adc_user" -> "adc_examination_followup" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_examination_followup.actor_id references adc_user.id; 0..*:1"];
"adc_next_visit_instruction" -> "adc_plan_appointment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_appointment.instruction_id references adc_next_visit_instruction.id; 0..*:1"];
"adc_visit" -> "adc_plan_appointment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_appointment.visit_id references adc_visit.id; 0..*:1"];
"adc_examination_followup" -> "adc_plan_appointment" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_plan_appointment.report_followup_id references adc_examination_followup.id; 0..*:0..1"];
"adc_visit" -> "adc_visit" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_visit.replaces_visit_id references adc_visit.id; 0..1:0..1"];
}
