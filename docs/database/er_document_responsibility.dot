digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR></TABLE>>];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="responsible_id">responsible_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="due_at">due_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="review_due_at">review_due_at ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="next_action_at">next_action_at ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_clinical_document_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="document_id">document_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="confirmed_by_id">confirmed_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="confirmed_at">confirmed_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="evidence_kind">evidence_kind</TD></TR></TABLE>>];
"adc_clinical_document_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="document_id">document_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR></TABLE>>];
"adc_clinical_encounter" -> "adc_clinical_document" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_document.encounter_id references adc_clinical_encounter.id; 0..1:1"];
"adc_user" -> "adc_clinical_document" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document.responsible_id references adc_user.id; 0..*:1"];
"adc_clinical_document" -> "adc_clinical_document_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_version.document_id references adc_clinical_document.id; 0..*:1"];
"adc_user" -> "adc_clinical_document_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_version.confirmed_by_id references adc_user.id; 0..*:1"];
"adc_clinical_document" -> "adc_clinical_document_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_event.document_id references adc_clinical_document.id; 0..*:1"];
"adc_clinical_document_version" -> "adc_clinical_document_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_document_event.version_id references adc_clinical_document_version.id; 0..*:0..1"];
"adc_user" -> "adc_clinical_document_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_event.actor_id references adc_user.id; 0..*:1"];
}
