digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_insurance_settlement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_settlement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_insurance_cancellation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_cancellation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="cancellation_id">cancellation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_insurance_reversal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_reversal</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="cancellation_id">cancellation_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="reference">reference</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="result">result</TD></TR></TABLE>>];
"adc_insurance_cancellation_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_cancellation_review</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="cancellation_id">cancellation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="decision">decision</TD></TR></TABLE>>];
"adc_insurance_settlement_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_settlement_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR></TABLE>>];
"adc_insurance_settlement" -> "adc_insurance_cancellation" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_insurance_cancellation.request_id references adc_insurance_settlement.id; 0..1:1"];
"adc_insurance_cancellation" -> "adc_insurance_reversal" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_insurance_reversal.cancellation_id references adc_insurance_cancellation.id; 0..1:1"];
"adc_insurance_cancellation" -> "adc_insurance_cancellation_review" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_cancellation_review.cancellation_id references adc_insurance_cancellation.id; 0..*:1"];
"adc_insurance_settlement" -> "adc_insurance_settlement_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_insurance_settlement_event.request_id references adc_insurance_settlement.id; 0..*:1"];
}
