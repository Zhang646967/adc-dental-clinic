digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR></TABLE>>];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_dentist_clinic_affiliation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist_clinic_affiliation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_on">starts_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_on">ends_on ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_availability_slot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_availability_slot</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="availability_slot_id">availability_slot_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="duration_minutes">duration_minutes</TD></TR></TABLE>>];
"adc_resource_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_resource_plan</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="offer_id">offer_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_current">is_current</TD></TR></TABLE>>];
"adc_resource_claim" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_resource_claim</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="asset_id">asset_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="active">active</TD></TR></TABLE>>];
"adc_dentist" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.dentist_id references adc_dentist.id; 0..*:1"];
"adc_clinic" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.clinic_id references adc_clinic.id; 0..*:1"];
"adc_clinic" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.clinic_id references adc_clinic.id; 0..*:1"];
"adc_dentist" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.dentist_id references adc_dentist.id; 0..*:1"];
"adc_clinic" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.clinic_id references adc_clinic.id; 0..*:1"];
"adc_dentist" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.dentist_id references adc_dentist.id; 0..*:1"];
"adc_availability_slot" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.availability_slot_id references adc_availability_slot.id; 0..*:1"];
"adc_visit" -> "adc_resource_plan" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_resource_plan.visit_id references adc_visit.id; 0..*:0..1"];
"adc_booking_service" -> "adc_resource_plan" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_plan.service_id references adc_booking_service.id; 0..*:1"];
"adc_resource_plan" -> "adc_resource_claim" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_resource_claim.plan_id references adc_resource_plan.id; 0..*:1"];
}
