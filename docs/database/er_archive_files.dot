digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinical_archive" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_archive</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR></TABLE>>];
"adc_archive_submission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_submission</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="previous_package_id">previous_package_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_archive_package" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_package</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="submission_id">submission_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="pdf_sha256">pdf_sha256</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="published_at">published_at</TD></TR></TABLE>>];
"adc_archive_amendment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_amendment</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR></TABLE>>];
"adc_archive_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="submission_id">submission_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="amendment_id">amendment_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="package_id">package_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_clinical_archive" -> "adc_archive_submission" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_submission.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_archive_package" -> "adc_archive_submission" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_submission.previous_package_id references adc_archive_package.id; 0..*:0..1"];
"adc_clinical_archive" -> "adc_archive_package" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_package.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_archive_submission" -> "adc_archive_package" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_archive_package.submission_id references adc_archive_submission.id; 0..1:1"];
"adc_archive_package" -> "adc_archive_package" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_archive_package.previous_id references adc_archive_package.id; 0..1:0..1"];
"adc_clinical_archive" -> "adc_archive_amendment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_amendment.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_clinical_archive" -> "adc_archive_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_event.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_archive_submission" -> "adc_archive_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_event.submission_id references adc_archive_submission.id; 0..*:0..1"];
"adc_archive_amendment" -> "adc_archive_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_event.amendment_id references adc_archive_amendment.id; 0..*:0..1"];
"adc_archive_package" -> "adc_archive_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_event.package_id references adc_archive_package.id; 0..*:0..1"];
"adc_user" -> "adc_archive_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_archive_event.actor_id references adc_user.id; 0..*:0..1"];
}
