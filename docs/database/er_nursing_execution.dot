digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="attended_at">attended_at ?</TD></TR></TABLE>>];
"adc_nursing_duty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_nursing_duty</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD></TR></TABLE>>];
"adc_nursing_execution" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_nursing_execution</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="duty_id">duty_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="performed_id">performed_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="issue_id">issue_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="sterile_pack_id">sterile_pack_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="observed_at">observed_at</TD></TR></TABLE>>];
"adc_performed_procedure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_performed_procedure</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_dispense_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dispense_movement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="line_id">line_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="requires_batch">requires_batch</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR></TABLE>>];
"adc_sterile_pack" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_sterile_pack</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="process_reference">process_reference</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="duty_id">duty_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD></TR></TABLE>>];
"adc_sterile_hold" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_sterile_hold</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="pack_id">pack_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="duty_id">duty_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR></TABLE>>];
"adc_visit" -> "adc_nursing_execution" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_nursing_execution.visit_id references adc_visit.id; 0..*:1"];
"adc_nursing_duty" -> "adc_nursing_execution" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_nursing_execution.duty_id references adc_nursing_duty.id; 0..*:1"];
"adc_performed_procedure" -> "adc_nursing_execution" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_nursing_execution.performed_id references adc_performed_procedure.id; 0..*:0..1"];
"adc_dispense_movement" -> "adc_nursing_execution" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_nursing_execution.issue_id references adc_dispense_movement.id; 0..*:0..1"];
"adc_sterile_pack" -> "adc_nursing_execution" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_nursing_execution.sterile_pack_id references adc_sterile_pack.id; 0..1:0..1"];
"adc_nursing_duty" -> "adc_sterile_pack" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_sterile_pack.duty_id references adc_nursing_duty.id; 0..*:1"];
"adc_sterile_pack" -> "adc_sterile_hold" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_sterile_hold.pack_id references adc_sterile_pack.id; 0..1:1"];
"adc_nursing_duty" -> "adc_sterile_hold" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_sterile_hold.duty_id references adc_nursing_duty.id; 0..*:1"];
}
