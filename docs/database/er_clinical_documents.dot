digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_visit_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision_no">revision_no</TD></TR></TABLE>>];
"adc_clinical_document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_clinical_document_draft" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_draft</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="document_id">document_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="base_version_id">base_version_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="payload">payload</TD></TR></TABLE>>];
"adc_clinical_document_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="document_id">document_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="prior_visit_version_id">prior_visit_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="care_record_id">care_record_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="content_digest">content_digest</TD></TR></TABLE>>];
"adc_visit" -> "adc_clinical_encounter" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_encounter.visit_id references adc_visit.id; 0..1:1"];
"adc_clinical_encounter" -> "adc_clinical_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_record_version.encounter_id references adc_clinical_encounter.id; 0..*:1"];
"adc_visit" -> "adc_visit_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit_record_version.visit_id references adc_visit.id; 0..*:1"];
"adc_clinical_encounter" -> "adc_clinical_document" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_document.encounter_id references adc_clinical_encounter.id; 0..1:1"];
"adc_clinical_document" -> "adc_clinical_document_draft" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_document_draft.document_id references adc_clinical_document.id; 0..1:1"];
"adc_clinical_document_version" -> "adc_clinical_document_draft" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_document_draft.base_version_id references adc_clinical_document_version.id; 0..*:0..1"];
"adc_clinical_document" -> "adc_clinical_document_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_version.document_id references adc_clinical_document.id; 0..*:1"];
"adc_clinical_document_version" -> "adc_clinical_document_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_clinical_document_version.previous_id references adc_clinical_document_version.id; 0..1:0..1"];
"adc_clinical_document_version" -> "adc_clinical_document_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_document_version.prior_visit_version_id references adc_clinical_document_version.id; 0..*:0..1"];
"adc_clinical_record_version" -> "adc_clinical_document_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_document_version.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_visit_record_version" -> "adc_clinical_document_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_document_version.care_record_id references adc_visit_record_version.id; 0..*:0..1"];
}
