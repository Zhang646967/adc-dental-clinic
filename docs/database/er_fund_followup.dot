digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_insurance_settlement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_insurance_settlement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="request_id">request_id</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_fund_issue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_fund_issue</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="claim_id">claim_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="opened_by_id">opened_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="amount">amount ?</TD></TR></TABLE>>];
"adc_fund_issue_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_fund_issue_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="issue_id">issue_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="owner_id">owner_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="due_at">due_at</TD></TR></TABLE>>];
"adc_insurance_settlement" -> "adc_fund_issue" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_issue.claim_id references adc_insurance_settlement.id; 0..*:1"];
"adc_user" -> "adc_fund_issue" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_issue.opened_by_id references adc_user.id; 0..*:1"];
"adc_fund_issue" -> "adc_fund_issue_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_issue_event.issue_id references adc_fund_issue.id; 0..*:1"];
"adc_user" -> "adc_fund_issue_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_issue_event.owner_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_fund_issue_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_fund_issue_event.actor_id references adc_user.id; 0..*:1"];
}
