digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_plan_step_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_step_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_next_visit_instruction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_next_visit_instruction</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_record_id">source_record_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_version_id">step_version_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="completion_rule">completion_rule</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="earliest_on">earliest_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="latest_on">latest_on</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="replaces_visit_id">replaces_visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_plan_appointment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_plan_appointment</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="instruction_id">instruction_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_clinical_record_version" -> "adc_next_visit_instruction" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_next_visit_instruction.source_record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_plan_step_version" -> "adc_next_visit_instruction" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_next_visit_instruction.step_version_id references adc_plan_step_version.id; 0..*:0..1"];
"adc_booking_service" -> "adc_next_visit_instruction" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_next_visit_instruction.service_id references adc_booking_service.id; 0..*:1"];
"adc_visit" -> "adc_visit" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_visit.replaces_visit_id references adc_visit.id; 0..1:0..1"];
"adc_next_visit_instruction" -> "adc_plan_appointment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_appointment.instruction_id references adc_next_visit_instruction.id; 0..*:1"];
"adc_visit" -> "adc_plan_appointment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_plan_appointment.visit_id references adc_visit.id; 0..*:1"];
}
