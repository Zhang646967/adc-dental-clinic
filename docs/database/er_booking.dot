digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR></TABLE>>];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="patient_no">patient_no</TD></TR></TABLE>>];
"adc_availability_slot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_availability_slot</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="availability_slot_id">availability_slot_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_reception_case" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_reception_case</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_reception_communication" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_reception_communication</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="case_id">case_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR></TABLE>>];
"adc_clinic" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.clinic_id references adc_clinic.id; 0..*:1"];
"adc_dentist" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.dentist_id references adc_dentist.id; 0..*:1"];
"adc_patient" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.patient_id references adc_patient.id; 0..*:1"];
"adc_availability_slot" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.availability_slot_id references adc_availability_slot.id; 0..*:1"];
"adc_clinic" -> "adc_reception_case" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reception_case.clinic_id references adc_clinic.id; 0..*:1"];
"adc_patient" -> "adc_reception_case" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_reception_case.patient_id references adc_patient.id; 0..*:0..1"];
"adc_visit" -> "adc_reception_case" [arrowtail="teeodot", arrowhead="teeodot", constraint=false, tooltip="adc_reception_case.visit_id references adc_visit.id; 0..1:0..1"];
"adc_reception_case" -> "adc_reception_communication" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_reception_communication.case_id references adc_reception_case.id; 0..*:1"];
}
