digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_patient_access" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient_access</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="patient_no">patient_no</TD></TR></TABLE>>];
"adc_portal_booking_receipt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_portal_booking_receipt</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="nonce">nonce</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="access_id">access_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="replaces_visit_id">replaces_visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="status">status</TD></TR></TABLE>>];
"adc_wait_offer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_wait_offer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_cancellation_followup" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_cancellation_followup</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="replacement_visit_id">replacement_visit_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_user" -> "adc_patient_access" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_patient_access.user_id references adc_user.id; 0..1:1"];
"adc_patient" -> "adc_patient_access" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_patient_access.patient_id references adc_patient.id; 0..1:1"];
"adc_patient_access" -> "adc_portal_booking_receipt" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_portal_booking_receipt.access_id references adc_patient_access.id; 0..*:1"];
"adc_visit" -> "adc_portal_booking_receipt" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_portal_booking_receipt.visit_id references adc_visit.id; 0..1:1"];
"adc_patient" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.patient_id references adc_patient.id; 0..*:1"];
"adc_visit" -> "adc_visit" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_visit.replaces_visit_id references adc_visit.id; 0..1:0..1"];
"adc_visit" -> "adc_wait_offer" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_wait_offer.visit_id references adc_visit.id; 0..1:0..1"];
"adc_visit" -> "adc_cancellation_followup" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_cancellation_followup.visit_id references adc_visit.id; 0..1:1"];
"adc_visit" -> "adc_cancellation_followup" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_cancellation_followup.replacement_visit_id references adc_visit.id; 0..*:0..1"];
}
