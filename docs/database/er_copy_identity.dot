digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="patient_no">patient_no</TD></TR></TABLE>>];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR></TABLE>>];
"adc_clinical_reviewer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_reviewer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="can_review_copies">can_review_copies</TD></TR></TABLE>>];
"adc_record_copy_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_record_copy_request</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="recipient_id">recipient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="created_by_id">created_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="verified_by_id">verified_by_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="assigned_reviewer_id">assigned_reviewer_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="purpose">purpose</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="pickup_until">pickup_until ?</TD></TR></TABLE>>];
"adc_user" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.user_id references adc_user.id; 0..*:1"];
"adc_clinic" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.clinic_id references adc_clinic.id; 0..*:1"];
"adc_patient" -> "adc_record_copy_request" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_request.patient_id references adc_patient.id; 0..*:1"];
"adc_clinic" -> "adc_record_copy_request" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_request.clinic_id references adc_clinic.id; 0..*:1"];
"adc_user" -> "adc_record_copy_request" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_request.recipient_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_record_copy_request" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_record_copy_request.created_by_id references adc_user.id; 0..*:1"];
"adc_user" -> "adc_record_copy_request" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_record_copy_request.verified_by_id references adc_user.id; 0..*:0..1"];
"adc_clinical_reviewer" -> "adc_record_copy_request" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_record_copy_request.assigned_reviewer_id references adc_clinical_reviewer.id; 0..*:0..1"];
"adc_user" -> "adc_record_copy_request" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_record_copy_request.reviewed_by_id references adc_user.id; 0..*:0..1"];
}
