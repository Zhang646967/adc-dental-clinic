digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="patient_no">patient_no</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_medical_proxy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_proxy</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="delegate_id">delegate_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_medical_proxy_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_proxy_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="proxy_id">proxy_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="number">number</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_from">valid_from</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD></TR></TABLE>>];
"adc_medical_proxy_scope" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_proxy_scope</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="step_id">step_id</TD></TR></TABLE>>];
"adc_treatment_step" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_step</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="plan_id">plan_id</TD></TR></TABLE>>];
"adc_medical_proxy_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_medical_proxy_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="proxy_id">proxy_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="version_id">version_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="sequence">sequence</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="resulting_state">resulting_state</TD></TR></TABLE>>];
"adc_patient" -> "adc_medical_proxy" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy.patient_id references adc_patient.id; 0..*:1"];
"adc_user" -> "adc_medical_proxy" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy.delegate_id references adc_user.id; 0..*:1"];
"adc_medical_proxy" -> "adc_medical_proxy_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_version.proxy_id references adc_medical_proxy.id; 0..*:1"];
"adc_medical_proxy_version" -> "adc_medical_proxy_scope" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_scope.version_id references adc_medical_proxy_version.id; 0..*:1"];
"adc_treatment_step" -> "adc_medical_proxy_scope" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_scope.step_id references adc_treatment_step.id; 0..*:1"];
"adc_medical_proxy" -> "adc_medical_proxy_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_event.proxy_id references adc_medical_proxy.id; 0..*:1"];
"adc_medical_proxy_version" -> "adc_medical_proxy_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_event.version_id references adc_medical_proxy_version.id; 0..*:1"];
"adc_user" -> "adc_medical_proxy_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_medical_proxy_event.actor_id references adc_user.id; 0..*:1"];
}
