digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_department" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_department</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR></TABLE>>];
"adc_department_hours" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_department_hours</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="weekday">weekday</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="opens_at">opens_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="closes_at">closes_at</TD></TR></TABLE>>];
"adc_treatment_room" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_treatment_room</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="code">code</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="department_id">department_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="duration_minutes">duration_minutes</TD></TR></TABLE>>];
"adc_service_presentation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_service_presentation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="category">category</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="fee_mode">fee_mode</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="fee_amount">fee_amount ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_published">is_published</TD></TR></TABLE>>];
"adc_service_requirement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_service_requirement</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="category">category</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="quantity">quantity</TD></TR></TABLE>>];
"adc_booking_service_dentists" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service_dentists</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="bookingservice_id">bookingservice_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR></TABLE>>];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR></TABLE>>];
"adc_clinic" -> "adc_department" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_department.clinic_id references adc_clinic.id; 0..*:1"];
"adc_department" -> "adc_department_hours" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_department_hours.department_id references adc_department.id; 0..*:1"];
"adc_department" -> "adc_treatment_room" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_treatment_room.department_id references adc_department.id; 0..*:1"];
"adc_department" -> "adc_booking_service" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_booking_service.department_id references adc_department.id; 0..*:1"];
"adc_booking_service" -> "adc_service_presentation" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_service_presentation.service_id references adc_booking_service.id; 0..1:1"];
"adc_booking_service" -> "adc_service_requirement" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_service_requirement.service_id references adc_booking_service.id; 0..*:1"];
"adc_booking_service" -> "adc_booking_service_dentists" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_booking_service_dentists.bookingservice_id references adc_booking_service.id; 0..*:1"];
"adc_dentist" -> "adc_booking_service_dentists" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_booking_service_dentists.dentist_id references adc_dentist.id; 0..*:1"];
}
