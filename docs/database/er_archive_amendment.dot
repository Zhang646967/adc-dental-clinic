digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinical_archive" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_archive</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR></TABLE>>];
"adc_archive_package" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_package</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR></TABLE>>];
"adc_archive_amendment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_archive_amendment</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="archive_id">archive_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="base_package_id">base_package_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="target">target</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="candidate_digest">candidate_digest</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="requested_by_id">requested_by_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="assigned_reviewer_id">assigned_reviewer_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewed_by_id">reviewed_by_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="result_document_id">result_document_id ?</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="result_record_id">result_record_id ?</TD></TR></TABLE>>];
"adc_clinical_document_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_document_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_clinical_archive" -> "adc_archive_package" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_package.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_clinical_archive" -> "adc_archive_amendment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_amendment.archive_id references adc_clinical_archive.id; 0..*:1"];
"adc_archive_package" -> "adc_archive_amendment" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_archive_amendment.base_package_id references adc_archive_package.id; 0..*:1"];
"adc_clinical_document_version" -> "adc_archive_amendment" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_archive_amendment.result_document_id references adc_clinical_document_version.id; 0..1:0..1"];
"adc_clinical_record_version" -> "adc_archive_amendment" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_archive_amendment.result_record_id references adc_clinical_record_version.id; 0..1:0..1"];
"adc_clinical_document_version" -> "adc_clinical_document_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_clinical_document_version.previous_id references adc_clinical_document_version.id; 0..1:0..1"];
"adc_clinical_record_version" -> "adc_clinical_record_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_clinical_record_version.previous_id references adc_clinical_record_version.id; 0..1:0..1"];
}
