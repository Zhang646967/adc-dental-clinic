digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_clinical_encounter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_encounter</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="visit_id">visit_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="opened_by_id">opened_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_clinical_draft" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_draft</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="base_record_id">base_record_id ?</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="recorded_by_id">recorded_by_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_tooth_finding" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_tooth_finding</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="record_id">record_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="line_no">line_no</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="tooth">tooth</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="surface">surface</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR></TABLE>>];
"adc_clinical_record_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="encounter_id">encounter_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="record_id">record_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="action">action</TD></TR></TABLE>>];
"adc_visit" -> "adc_clinical_encounter" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_encounter.visit_id references adc_visit.id; 0..1:1"];
"adc_user" -> "adc_clinical_encounter" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_encounter.opened_by_id references adc_user.id; 0..*:1"];
"adc_clinical_encounter" -> "adc_clinical_draft" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_draft.encounter_id references adc_clinical_encounter.id; 0..1:1"];
"adc_clinical_record_version" -> "adc_clinical_draft" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_draft.base_record_id references adc_clinical_record_version.id; 0..*:0..1"];
"adc_clinical_encounter" -> "adc_clinical_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_record_version.encounter_id references adc_clinical_encounter.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_clinical_record_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_clinical_record_version.previous_id references adc_clinical_record_version.id; 0..1:0..1"];
"adc_user" -> "adc_clinical_record_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_record_version.recorded_by_id references adc_user.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_tooth_finding" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_tooth_finding.record_id references adc_clinical_record_version.id; 0..*:1"];
"adc_clinical_encounter" -> "adc_clinical_record_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_record_event.encounter_id references adc_clinical_encounter.id; 0..*:0..1"];
"adc_clinical_record_version" -> "adc_clinical_record_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_record_event.record_id references adc_clinical_record_version.id; 0..*:0..1"];
}
