digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_dentist" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="employee_no">employee_no</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="name">name</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_dentist_clinic_affiliation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_dentist_clinic_affiliation</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="kind">kind</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_on">starts_on</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_on">ends_on ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="listing_published">listing_published</TD></TR></TABLE>>];
"adc_clinic_profile_policy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic_profile_policy</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="roster_enforced">roster_enforced</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR></TABLE>>];
"adc_professional_authorization" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_professional_authorization</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR></TABLE>>];
"adc_availability_slot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_availability_slot</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="dentist_id">dentist_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="starts_at">starts_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="ends_at">ends_at</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_dentist" -> "adc_user" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_user.dentist_id references adc_dentist.id; 0..1:0..1"];
"adc_dentist" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.dentist_id references adc_dentist.id; 0..*:1"];
"adc_clinic" -> "adc_dentist_clinic_affiliation" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_dentist_clinic_affiliation.clinic_id references adc_clinic.id; 0..*:1"];
"adc_clinic" -> "adc_clinic_profile_policy" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinic_profile_policy.clinic_id references adc_clinic.id; 0..1:1"];
"adc_user" -> "adc_professional_authorization" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_professional_authorization.user_id references adc_user.id; 0..*:1"];
"adc_clinic" -> "adc_professional_authorization" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_professional_authorization.clinic_id references adc_clinic.id; 0..*:1"];
"adc_dentist" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.dentist_id references adc_dentist.id; 0..*:1"];
"adc_clinic" -> "adc_availability_slot" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_availability_slot.clinic_id references adc_clinic.id; 0..*:1"];
}
