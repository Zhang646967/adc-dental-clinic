digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_next_visit_instruction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_next_visit_instruction</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="completion_rule">completion_rule</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_performed_procedure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_performed_procedure</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_clinical_recall" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_recall</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="instruction_id">instruction_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="owner_id">owner_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="completion_record_id">completion_record_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="completion_performed_id">completion_performed_id ?</TD></TR></TABLE>>];
"adc_clinical_recall_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_recall_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="episode_id">episode_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_next_visit_instruction" -> "adc_clinical_recall" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_recall.instruction_id references adc_next_visit_instruction.id; 0..1:1"];
"adc_user" -> "adc_clinical_recall" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_recall.owner_id references adc_user.id; 0..*:1"];
"adc_clinical_record_version" -> "adc_clinical_recall" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_recall.completion_record_id references adc_clinical_record_version.id; 0..*:0..1"];
"adc_performed_procedure" -> "adc_clinical_recall" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_recall.completion_performed_id references adc_performed_procedure.id; 0..*:0..1"];
"adc_clinical_recall" -> "adc_clinical_recall_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_recall_event.episode_id references adc_clinical_recall.id; 0..*:1"];
"adc_user" -> "adc_clinical_recall_event" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_recall_event.actor_id references adc_user.id; 0..*:1"];
}
