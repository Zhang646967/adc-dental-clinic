digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_booking_service" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_booking_service</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR></TABLE>>];
"adc_clinical_reviewer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_reviewer</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
"adc_professional_authorization" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_professional_authorization</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="user_id">user_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="service_id">service_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="state">state</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD></TR></TABLE>>];
"adc_clinical_authority_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_authority_event</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="authorization_id">authorization_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reviewer_id">reviewer_id ?</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="operation_id">operation_id</TD></TR></TABLE>>];
"adc_clinical_authority_policy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_authority_policy</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="clinic_id">clinic_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="activated_by_id">activated_by_id</TD></TR></TABLE>>];
"adc_user" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.user_id references adc_user.id; 0..*:1"];
"adc_clinic" -> "adc_clinical_reviewer" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_reviewer.clinic_id references adc_clinic.id; 0..*:1"];
"adc_user" -> "adc_professional_authorization" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_professional_authorization.user_id references adc_user.id; 0..*:1"];
"adc_clinic" -> "adc_professional_authorization" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_professional_authorization.clinic_id references adc_clinic.id; 0..*:1"];
"adc_booking_service" -> "adc_professional_authorization" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_professional_authorization.service_id references adc_booking_service.id; 0..*:0..1"];
"adc_professional_authorization" -> "adc_clinical_authority_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_authority_event.authorization_id references adc_professional_authorization.id; 0..*:0..1"];
"adc_clinical_reviewer" -> "adc_clinical_authority_event" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_authority_event.reviewer_id references adc_clinical_reviewer.id; 0..*:0..1"];
"adc_clinic" -> "adc_clinical_authority_policy" [arrowtail="teetee", arrowhead="teeodot", tooltip="adc_clinical_authority_policy.clinic_id references adc_clinic.id; 0..1:1"];
"adc_user" -> "adc_clinical_authority_policy" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_authority_policy.activated_by_id references adc_user.id; 0..*:1"];
}
