digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.40", ranksep="0.48", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [color="#505965", arrowsize=0.8, dir=both];
"adc_patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_patient</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="patient_no">patient_no</TD></TR></TABLE>>];
"adc_clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinic</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="clinic_code">clinic_code</TD></TR></TABLE>>];
"adc_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_user</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT" PORT="username">username</TD></TR></TABLE>>];
"adc_visit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_visit</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR></TABLE>>];
"adc_clinical_history_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_history_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="scope_clinic_id">scope_clinic_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="source_visit_id">source_visit_id ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="reported_by_id">reported_by_id</TD></TR><TR><TD ALIGN="LEFT">FK/UK</TD><TD ALIGN="LEFT" PORT="previous_id">previous_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="revision">revision</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="source">source</TD></TR></TABLE>>];
"adc_clinical_record_version" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#e8edf2" BORDER="1"><B>adc_clinical_record_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT" PORT="id">id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT" PORT="history_id">history_id ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="history_review">history_review</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT" PORT="history_cursor">history_cursor</TD></TR></TABLE>>];
"adc_patient" -> "adc_visit" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_visit.patient_id references adc_patient.id; 0..*:1"];
"adc_patient" -> "adc_clinical_history_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_history_version.patient_id references adc_patient.id; 0..*:1"];
"adc_clinic" -> "adc_clinical_history_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_history_version.scope_clinic_id references adc_clinic.id; 0..*:0..1"];
"adc_visit" -> "adc_clinical_history_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_history_version.source_visit_id references adc_visit.id; 0..*:0..1"];
"adc_user" -> "adc_clinical_history_version" [arrowtail="teetee", arrowhead="crowodot", tooltip="adc_clinical_history_version.reported_by_id references adc_user.id; 0..*:1"];
"adc_clinical_history_version" -> "adc_clinical_history_version" [arrowtail="teeodot", arrowhead="teeodot", tooltip="adc_clinical_history_version.previous_id references adc_clinical_history_version.id; 0..1:0..1"];
"adc_clinical_history_version" -> "adc_clinical_record_version" [arrowtail="teeodot", arrowhead="crowodot", tooltip="adc_clinical_record_version.history_id references adc_clinical_history_version.id; 0..*:0..1"];
}
