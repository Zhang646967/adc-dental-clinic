# Append/edit ONLY AI-related entries in the existing .env. Never replace DB settings.
AI_MODE=demo
AI_BASE_URL=https://api.openai.com/v1
AI_ALLOWED_HOSTS=api.openai.com
AI_MODEL=
AI_API_KEY=
AI_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_TIMEOUT_SECONDS=20
AI_USER_MINUTE_LIMIT=10
AI_USER_DAILY_LIMIT=100
AI_GLOBAL_DAILY_LIMIT=1000
# For a provider-compatible endpoint: use its documented base URL, model ID,
# add only its approved hostname, and select its supported token-limit field.
# Chat Completions JSON-mode compatibility is required; no vendor compatibility is assumed.
